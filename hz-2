-- A text command parser. Deliberately no GUI: nothing is inserted into the
-- render tree, so the panel cannot be detected by inspecting PlayerGui and cannot
-- interfere with the client's rendering loop.

local Panel: any = nil
local Commands = {}

local registry: { [string]: Command } = {}
local order: { string } = {}

local function define(name: string, desc: string, usage: string, fn: (args: { string }) -> (boolean, any)): ()
	local key = string.lower(name)
	if registry[key] == nil then
		order[#order + 1] = key
	end
	registry[key] = {
		name = key,
		desc = desc,
		usage = usage,
		run = fn,
	}
end

local function panelText(): string
	if Panel == nil then
		return "HZ-2 panel not ready"
	end
	local ok, result = pcall(Panel.render)
	if ok and type(result) == "string" then
		return result
	end
	return "HZ-2 panel unavailable"
end

local function requireCore(): (any?, string?)
	if State.core == nil or not State.link.linked then
		return nil, "not linked to /hz-1 (run :link first)"
	end
	return State.core, nil
end

local function coreCall(method: string, ...: any): (boolean, any)
	local core, reason = requireCore()
	if core == nil then
		return false, reason
	end
	local fn = core[method]
	if type(fn) ~= "function" then
		return false, "core has no method '" .. method .. "'"
	end
	local packed = table.pack(...)
	local ok, result = pcall(function(): any
		return fn(table.unpack(packed, 1, packed.n))
	end)
	if not ok then
		return false, tostring(result)
	end
	return true, result
end

