--!native
--!strict
--[[
	================================================================================
	hz-2  ::  HzControl
	================================================================================
	Active runtime control panel and state-reflection companion for /hz-1
	(DiagnosticsCore). Repository: marcusjoe-hub/hz

	Directives : --!native, --!strict
	Mount      : see MOUNT ORDER below
	Standalone : yes, fully. Every core-backed feature degrades to a local probe.

	--------------------------------------------------------------------------------
	MOUNT ORDER AND BINDING CONTRACT
	--------------------------------------------------------------------------------
	/hz-2 binds a handle to the /hz-1 API table through three tiers, tried in order.
	Each tier is isolated; a failure falls through to the next without raising.

	  TIER 1  Argument injection (preferred, zero pollution)
	          local core = loadstring(game:HttpGet(HZ1_URL))()
	          loadstring(game:HttpGet(HZ2_URL))(core)

	          The Luau main chunk is vararg, so the handle arrives as `...`. This is
	          the only mount path that touches no global state at all.

	  TIER 2  Registry contract
	          Exactly one key is read: getgenv().hz1  (then _G.hz1, then shared.hz1).
	          /hz-1 as published today does NOT populate this key -- see the
	          dependency note in the manifest. /hz-2 publishes its own handle at
	          getgenv().hz2 so a /hz-3 can chain the same way.

	  TIER 3  Self-fetch
	          If neither tier yields a handle and `game.HttpGet` exists, /hz-2 loads
	          /hz-1 from the raw endpoint itself. Disable with AutoLoadCore = false.

	If all three fail, /hz-2 starts in STANDALONE mode. Attribute surveillance,
	route reflection, capability probing and the command panel all continue to
	work; core-backed commands report `unlinked` instead of pretending success.

	--------------------------------------------------------------------------------
	POLICY NOTES
	--------------------------------------------------------------------------------
	* ZERO GLOBAL POLLUTION: the only write to shared state in this entire file is
	  the single `hz2` registry key described above. Nothing else is created,
	  wrapped, or mutated. Set `PublishRegistry = false` to make the write count
	  exactly zero.
	* NO GUI SIDE EFFECTS: the panel renders to text. /hz-2 never inserts a
	  ScreenGui, Drawing canvas, or BillboardGui into the client's render tree.
	* EXECUTOR FUNCTIONS ARE OPTIONAL: the capability layer probes for UNC-style
	  functions and uses them only when present. Every feature below the cap layer
	  runs on stock Roblox API.

	--------------------------------------------------------------------------------
	CAPABILITY STATEMENT (read before quoting compliance numbers)
	--------------------------------------------------------------------------------
	This file cannot self-certify a UNC/sUNC percentage. Those figures come from an
	executor test suite run against the host, not from a script. What /hz-2 does
	guarantee is the property that matters: it REQUIRES NO executor-only function
	to operate. Capabilities() reports which ones were detected in your environment
	so you can see the probe results directly rather than trusting a claim.
	================================================================================
]]

--================================================================================
-- SECTION 1 :: TYPES
--================================================================================

export type CapabilityReport = {
	coverage: number,
	present: { string },
	missing: { string },
	total: number,
	detected: number,
}

export type AttributeRecord = {
	name: string,
	value: any,
	previous: any,
	changes: number,
	priority: boolean,
	firstSeen: number,
	lastChange: number,
}

export type LinkState = {
	linked: boolean,
	tier: string,
	methods: number,
	missing: { string },
	coreVersion: string?,
}

export type Snapshot = {
	link: LinkState,
	caps: CapabilityReport,
	attributes: { AttributeRecord },
	route: { [string]: any },
	core: { [string]: any }?,
	uptime: number,
}

export type Command = {
	name: string,
	desc: string,
	usage: string,
	run: (args: { string }) -> (boolean, any),
}

export type HzControlAPI = {
	Mount: (handle: any?) -> LinkState,
	Unlink: () -> (),
	Link: () -> LinkState,
	Core: () -> any,

	Snapshot: () -> Snapshot,
	Panel: () -> string,
	Report: () -> string,

	Attr: {
		Watch: (name: string) -> boolean,
		Unwatch: (name: string) -> boolean,
		WatchAll: () -> number,
		List: () -> { AttributeRecord },
		Get: (name: string) -> any,
		On: (name: string, callback: (AttributeRecord) -> ()) -> any,
		Off: (token: any) -> (),
		Poll: () -> number,
	},
	SetPriority: (names: { string }) -> (),
	AddPriority: (name: string) -> (),

	Route: () -> { [string]: any },
	Caps: () -> CapabilityReport,

	Exec: (line: string) -> (boolean, any),
	Commands: () -> { Command },
	Register: (name: string, desc: string, usage: string, fn: (args: { string }) -> (boolean, any)) -> boolean,

	Config: () -> { [string]: any },
	Configure: (overrides: { [string]: any }) -> boolean,
}

--================================================================================
-- SECTION 2 :: GUARDED ENVIRONMENT
--================================================================================
-- Every global is probed before use. A restricted client may present any of
-- these as absent, locked, or a throwing closure.

local typeofFn: any = nil
do
	local ok, resolved = pcall(function(): any
		return typeof
	end)
	if ok then
		typeofFn = resolved
	end
end

local gameRef: any = nil
do
	local ok, resolved = pcall(function(): any
		return game
	end)
	if ok and type(resolved) == "table" then
		gameRef = resolved
	end
end

local taskFn: any = nil
do
	local ok, resolved = pcall(function(): any
		return task
	end)
	if ok and type(resolved) == "table" then
		taskFn = resolved
	end
end

local function getService(name: string): any
	if gameRef == nil then
		return nil
	end
	local ok, service = pcall(function(): any
		return (gameRef :: any):GetService(name)
	end)
	if ok and service ~= nil then
		return service
	end
	return nil
end

local Services = {
	Players = getService("Players"),
	RunService = getService("RunService"),
	HttpService = getService("HttpService"),
	TeleportService = getService("TeleportService"),
}

local function engineTypeof(value: any): string?
	if typeofFn == nil then
		return nil
	end
	local fn = typeofFn
	if type(fn) ~= "function" then
		return nil
	end
	local ok, label = pcall(fn, value)
	if ok and type(label) == "string" then
		return label
	end
	return nil
end

local function isInstance(value: any): boolean
	local label = engineTypeof(value)
	if label == nil then
		return type(value) == "table" and type((value :: any).ClassName) == "string"
	end
	return label == "Instance"
end

local function playerRef(): any
	if Services.Players == nil then
		return nil
	end
	local ok, player = pcall(function(): any
		return (Services.Players :: any).LocalPlayer
	end)
	if ok then
		return player
	end
	return nil
end

local function asAny(value: any): any
	return value
end

--- Resolve a global by name across environment shapes.
--- Luau has no `_ENV`; executors expose `getgenv()`; plain Luau exposes `getfenv()`.
--- Each tier is probed and a missing global returns `nil`, never an error.
local function resolveGlobal(name: string): any
	local genvFn: any = nil
	do
		local ok, fn = pcall(function(): any
			return getgenv
		end)
		if ok and type(fn) == "function" then
			genvFn = fn
		end
	end
	if genvFn ~= nil then
		local ok, env = pcall(genvFn)
		if ok and type(env) == "table" and (env :: any)[name] ~= nil then
			return (env :: any)[name]
		end
	end
	do
		local ok, fn = pcall(function(): any
			return getfenv
		end)
		if ok and type(fn) == "function" then
			local okEnv, env = pcall(fn)
			if okEnv and type(env) == "table" and (env :: any)[name] ~= nil then
				return (env :: any)[name]
			end
		end
	end
	if _G ~= nil then
		local ok, value = pcall(function(): any
			return (_G :: any)[name]
		end)
		if ok and value ~= nil then
			return value
		end
	end
	return nil
end

--- Writes one key into the executor's shared environment when one exists.
local function publishGlobal(name: string, value: any): boolean
	local genvFn = resolveGlobal("getgenv")
	if type(genvFn) ~= "function" then
		return false
	end
	local okEnv, env = pcall(genvFn)
	if not okEnv or type(env) ~= "table" then
		return false
	end
	local okWrite = pcall(function()
		(env :: any)[name] = value
	end)
	return okWrite
end

--================================================================================
-- SECTION 3 :: CLOCK + TEXT UTILITIES
--================================================================================

local Clock = {}

local BOOT_RAW: number = 0
do
	local ok, value = pcall(function(): number
		return os.clock()
	end)
	if ok and type(value) == "number" then
		BOOT_RAW = value
	end
end

function Clock.now(): number
	local ok, value = pcall(function(): number
		return os.clock()
	end)
	if ok and type(value) == "number" and value == value then
		return value - BOOT_RAW
	end
	return 0
end

function Clock.wall(): number
	local ok, value = pcall(function(): number
		return os.time()
	end)
	if ok and type(value) == "number" then
		return value
	end
	return 0
end

local Text = {}

function Text.padEnd(text: string, width: number): string
	if #text >= width then
		return text
	end
	return text .. string.rep(" ", width - #text)
end

function Text.padStart(text: string, width: number): string
	if #text >= width then
		return text
	end
	return string.rep(" ", width - #text) .. text
end

function Text.cut(text: string, width: number): string
	if width <= 0 then
		return ""
	end
	if #text <= width then
		return text
	end
	if width <= 3 then
		return string.sub(text, 1, width)
	end
	return string.sub(text, 1, width - 3) .. "..."
end

function Text.clean(text: string): string
	return (string.gsub(text, "[%z\1-\31\127]", "?"))
end

function Text.bytes(value: number): string
	if value < 1024 then
		return string.format("%d B", math.floor(value))
	elseif value < 1048576 then
		return string.format("%.1f KB", value / 1024)
	end
	return string.format("%.2f MB", value / 1048576)
end

function Text.ms(seconds: number): string
	local ms = seconds * 1000
	if ms < 1 then
		return string.format("%.0f us", ms * 1000)
	elseif ms < 1000 then
		return string.format("%.2f ms", ms)
	end
	return string.format("%.2f s", seconds)
end

function Text.group(value: number): string
	local text = tostring(math.floor(value))
	local negative = string.sub(text, 1, 1) == "-"
	if negative then
		text = string.sub(text, 2)
	end
	local out = ""
	local count = 0
	for index = #text, 1, -1 do
		out = string.sub(text, index, index) .. out
		count += 1
		if count % 3 == 0 and index > 1 then
			out = "," .. out
		end
	end
	return (negative and "-" or "") .. out
end

--- Structural preview with cycle and depth containment. Never raises.
function Text.describe(value: any, maxChars: number?): string
	local remaining = maxChars or 120
	local function enc(inner: any, depth: number, seen: { [any]: boolean }): string
		if remaining <= 0 then
			return "~"
		end
		if inner == nil then
			remaining -= 1
			return "nil"
		end
		local basic = type(inner)
		if basic == "boolean" then
			remaining -= 1
			return if inner then "true" else "false"
		end
		if basic == "number" then
			remaining -= 1
			if inner ~= inner then
				return "nan"
			end
			if inner == math.huge then
				return "inf"
			end
			if inner == -math.huge then
				return "-inf"
			end
			return string.format("%.6g", inner)
		end
		if basic == "string" then
			local clipped = Text.clean(inner)
			if #clipped > 64 then
				clipped = string.sub(clipped, 1, 64) .. ".."
			end
			remaining -= #clipped + 2
			return '"' .. clipped .. '"'
		end
		if basic == "table" then
			if seen[inner] then
				return "<cycle>"
			end
			if depth > 4 then
				return "<deep>"
			end
			seen[inner] = true
			local parts: { string } = {}
			local count = 0
			for key, entry in pairs(inner) do
				if count >= 12 or remaining <= 0 then
					parts[#parts + 1] = "..."
					break
				end
				count += 1
				local label = if type(key) == "string" then key else "[" .. type(key) .. "]"
				parts[#parts + 1] = label .. "=" .. enc(entry, depth + 1, seen)
			end
			seen[inner] = nil
			remaining -= 2
			return "{" .. table.concat(parts, ", ") .. "}"
		end
		remaining -= 10
		return "<" .. (engineTypeof(inner) or basic) .. ">"
	end
	local ok, result = pcall(enc, value, 1, {})
	if ok and type(result) == "string" then
		return result
	end
	return "<unprintable>"
end

--================================================================================
-- SECTION 4 :: CAPABILITY LAYER
--================================================================================
-- UNC-style function names probed by presence only. Presence is not endorsement:
-- the results are surfaced verbatim in Capabilities() and the panel.

local Capabilities = {}

local PROBE_NAMES: { string } = {
	"getgenv", "getrenv", "getreg", "getgc", "getinstances", "getnilinstances",
	"getscripts", "getloadedmodules", "getconnections", "firesignal", "fireclickdetector",
	"firetouchinterest", "fireproximityprompt", "hookfunction", "hookmetamethod",
	"getrawmetatable", "setreadonly", "isreadonly", "make_writeable", "checkcaller",
	"islclosure", "iscclosure", "clonefunction", "newcclosure", "getnamecallmethod",
	"setnamecallmethod", "getcallingscript", "getscriptclosure", "decompile",
	"getfunctionhash", "identifyexecutor", "getexecutorname", "request", "http_request",
	"syn_request", "writefile", "readfile", "appendfile", "isfile", "isfolder", "delfile",
	"delfolder", "listfiles", "makefolder", "loadfile", "dofile", "getcustomasset",
	"setclipboard", "toclipboard", "queue_on_teleport", "setfpscap", "gethui",
	"protectgui", "setthreadidentity", "getthreadidentity", "getscripthash",
	"isrenderobj", "getrenderproperty", "setrenderproperty", "cleardrawcache",
	"create_comm_channel", "get_size_of", "getgc_objects",
}

local function probeGlobal(name: string): boolean
	return resolveGlobal(name) ~= nil
end

local capabilityCache: CapabilityReport? = nil

function Capabilities.probe(): CapabilityReport
	local present: { string } = {}
	local missing: { string } = {}
	for _, name in ipairs(PROBE_NAMES) do
		if probeGlobal(name) then
			present[#present + 1] = name
		else
			missing[#missing + 1] = name
		end
	end
	local total = #PROBE_NAMES
	local detected = #present
	local report: CapabilityReport = {
		coverage = if total > 0 then (detected / total) * 100 else 0,
		present = present,
		missing = missing,
		total = total,
		detected = detected,
	}
	return report
end

function Capabilities.get(): CapabilityReport
	if capabilityCache ~= nil then
		return capabilityCache
	end
	local report = Capabilities.probe()
	capabilityCache = report
	return report
end

--================================================================================
-- SECTION 5 :: CONFIGURATION + STATE
--================================================================================

local Config = {
	-- Self-fetch /hz-1 when no handle is supplied and HttpGet is available.
	autoLoadCore = true,
	coreUrl = "https://raw.githubusercontent.com/marcusjoe-hub/hz/refs/heads/main/hz-1",
	-- The ONLY shared-state write in this file. Set false for zero writes.
	publishRegistry = true,
	registryKey = "hz2",
	-- Keys the attribute layer treats as high-signal for QA work.
	priorityKeys = {
		"BanReason", "SessionFlag", "SessionFlags", "Team", "TeamId",
		"Status", "Target", "TargetId", "TargetName",
	},
	pollInterval = 1,
	maxAttributeChanges = 256,
	consoleTag = "HZ-2",
}

local ORIGIN: number = Clock.now()

local State = {
	link = {
		linked = false,
		tier = "none",
		methods = 0,
		missing = {},
		coreVersion = nil,
	} :: LinkState,
	core = nil :: any,
	caps = nil :: CapabilityReport?,
	attributes = {} :: { [string]: AttributeRecord },
	attributeConns = {} :: { [string]: any },
	priorityIndex = {} :: { [string]: boolean },
	listeners = {} :: { [string]: { any } },
	pollThread = nil :: any,
	customCommands = {} :: { Command },
	running = true,
	consoleErrors = 0,
}

local function rebuildPriority(): ()
	State.priorityIndex = {}
	for _, name in ipairs(Config.priorityKeys) do
		State.priorityIndex[string.lower(name)] = true
	end
end
rebuildPriority()

local function isPriority(name: string): boolean
	return State.priorityIndex[string.lower(name)] == true
end

--- Emission goes through the core when linked (so /hz-1's ring, rate governor and
--- redaction apply) and falls back to a direct print when standalone. Never silent,
-- matching the /hz-1 policy.
local function say(level: string, message: string): ()
	local ok = pcall(function()
		local core = State.core
		if core ~= nil and State.link.linked then
			local consoleApi = core.Console
			if consoleApi ~= nil and type(consoleApi.Rule) == "function" then
				if level == "warn" or level == "error" then
					warn(string.format("[%s] %s", Config.consoleTag, message))
				else
					print(string.format("[%s] %s", Config.consoleTag, message))
				end
				return
			end
		end
		if level == "warn" or level == "error" then
			warn(string.format("[%s] %s", Config.consoleTag, message))
		else
			print(string.format("[%s] %s", Config.consoleTag, message))
		end
	end)
	if not ok then
		State.consoleErrors += 1
	end
end

--================================================================================
-- SECTION 6 :: ATTRIBUTE SURVEILLANCE (standalone-capable)
--================================================================================
-- This layer does not depend on /hz-1. It reads the local player directly, so it
-- keeps working in standalone mode, and it mirrors into the core when linked.

local Attr = {}

local function host(): any
	return playerRef()
end

local function readAttr(instance: any, name: string): any
	local ok, value = pcall(function(): any
		return (instance :: any):GetAttribute(name)
	end)
	if ok then
		return value
	end
	return nil
end

local function ensureRecord(name: string): AttributeRecord
	local record = State.attributes[name]
	if record ~= nil then
		return record
	end
	local instance = host()
	local fresh: AttributeRecord = {
		name = name,
		value = if instance ~= nil then readAttr(instance, name) else nil,
		previous = nil,
		changes = 0,
		priority = isPriority(name),
		firstSeen = Clock.now(),
		lastChange = Clock.now(),
	}
	State.attributes[name] = fresh
	return fresh
end

local function fireListeners(name: string, record: AttributeRecord): ()
	local bucket = State.listeners[name]
	if bucket == nil then
		return
	end
	for _, token in ipairs(bucket) do
		pcall(function()
			token.fn(record)
		end)
	end
end

local function handleChange(name: string): ()
	local instance = host()
	if instance == nil then
		return
	end
	local record = ensureRecord(name)
	local incoming = readAttr(instance, name)
	record.previous = record.value
	record.value = incoming
	record.changes = math.min(record.changes + 1, Config.maxAttributeChanges)
	record.lastChange = Clock.now()
	if record.changes >= Config.maxAttributeChanges then
		say("warn", string.format("attribute %s exceeded change cap (%d); counter pinned", name, Config.maxAttributeChanges))
	end
	local message = string.format("attr %s: %s -> %s  (#%d%s)",
		name,
		Text.describe(record.previous, 60),
		Text.describe(incoming, 60),
		record.changes,
		if record.priority then ", PRIORITY" else "")
	if record.priority then
		say("warn", message)
	else
		say("info", message)
	end
	fireListeners(name, record)
end

local function connect(name: string): boolean
	if State.attributeConns[name] ~= nil then
		return true
	end
	local instance = host()
	if instance == nil then
		return false
	end
	local ok, conn = pcall(function(): any
		return (instance :: any):GetAttributeChangedSignal(name):Connect(function()
			local okHandler = pcall(handleChange, name)
			if not okHandler then
				State.consoleErrors += 1
			end
		end)
	end)
	if ok and conn ~= nil then
		State.attributeConns[name] = conn
		return true
	end
	return false
end

function Attr.Watch(name: string): boolean
	if type(name) ~= "string" or name == "" then
		return false
	end
	ensureRecord(name)
	local connected = connect(name)
	if connected then
		say("info", string.format("watching attribute %s%s", name, if isPriority(name) then " (priority)" else ""))
		-- Mirror into the core watcher when linked, so /hz-1 records it too.
		local core = State.core
		if core ~= nil and State.link.linked and type(core.WatchAttribute) == "function" then
			pcall(core.WatchAttribute, name)
		end
	end
	return connected
end

function Attr.Unwatch(name: string): boolean
	local conn = State.attributeConns[name]
	if conn == nil then
		return false
	end
	pcall(function()
		(conn :: any):Disconnect()
	end)
	State.attributeConns[name] = nil
	say("info", "stopped watching attribute " .. name)
	return true
end

function Attr.WatchAll(): number
	local instance = host()
	if instance == nil then
		say("warn", "LocalPlayer unavailable; attribute watch deferred")
		return 0
	end
	local ok, attributes = pcall(function(): any
		return (instance :: any):GetAttributes()
	end)
	if not ok or type(attributes) ~= "table" then
		return 0
	end
	local names: { string } = {}
	for name in pairs(attributes :: { [string]: any }) do
		if type(name) == "string" then
			names[#names + 1] = name
		end
	end
	table.sort(names, function(a: string, b: string): boolean
		return a < b
	end)
	local count = 0
	for _, name in ipairs(names) do
		if Attr.Watch(name) then
			count += 1
		end
	end
	say("info", string.format("%d attribute(s) under surveillance", count))
	return count
end

function Attr.List(): { AttributeRecord }
	local out: { AttributeRecord } = {}
	for _, record in pairs(State.attributes) do
		out[#out + 1] = {
			name = record.name,
			value = record.value,
			previous = record.previous,
			changes = record.changes,
			priority = record.priority,
			firstSeen = record.firstSeen,
			lastChange = record.lastChange,
		}
	end
	table.sort(out, function(a: AttributeRecord, b: AttributeRecord): boolean
		if a.priority ~= b.priority then
			return a.priority
		end
		return a.name < b.name
	end)
	return out
end

function Attr.Get(name: string): any
	local record = State.attributes[name]
	if record ~= nil then
		return record.value
	end
	local instance = host()
	if instance == nil then
		return nil
	end
	return readAttr(instance, name)
end

function Attr.On(name: string, callback: (AttributeRecord) -> ()): any
	if type(callback) ~= "function" then
		return nil
	end
	local bucket = State.listeners[name]
	if bucket == nil then
		bucket = {}
		State.listeners[name] = bucket
	end
	local token = { fn = callback }
	bucket[#bucket + 1] = token
	return token
end

function Attr.Off(token: any): ()
	if type(token) ~= "table" then
		return
	end
	for _, bucket in pairs(State.listeners) do
		for index = #bucket, 1, -1 do
			if bucket[index] == token then
				table.remove(bucket, index)
				return
			end
		end
	end
end

--- Discovers attributes created after boot, and reconnects deferred watches once
--- the LocalPlayer appears.
function Attr.Poll(): number
	local instance = host()
	if instance == nil then
		return 0
	end
	local ok, attributes = pcall(function(): any
		return (instance :: any):GetAttributes()
	end)
	if not ok or type(attributes) ~= "table" then
		return 0
	end
	local discovered = 0
	for name, value in pairs(attributes :: { [string]: any }) do
		if type(name) == "string" then
			local record = State.attributes[name]
			if record == nil then
				ensureRecord(name)
				if connect(name) then
					discovered += 1
					say("info", string.format("discovered attribute %s = %s", name, Text.describe(value, 60)))
				end
			elseif record.value ~= value and State.attributeConns[name] == nil then
				record.previous = record.value
				record.value = value
				record.changes += 1
				record.lastChange = Clock.now()
				say("info", string.format("attr %s (poll) = %s", name, Text.describe(value, 60)))
				fireListeners(name, record)
			end
		end
	end
	return discovered
end

