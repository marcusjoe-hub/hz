define("fire", "Fire a remote through the core router", ":fire <path> [json-ish args]", function(args: { string }): (boolean, any)
	if args[1] == nil then
		return false, "usage: :fire <RemotePath> [arg]"
	end
	local core, reason = requireCore()
	if core == nil then
		return false, reason
	end
	local target = args[1]
	local resolved: any = nil
	local function resolve(root: any)
		if root == nil then return nil end
		local ok, found = pcall(function(): any
			local current = root
			for segment in string.gmatch(target, "[^%.]+") do
				if current == nil then return nil end
				current = (current :: any)[segment]
			end
			return current
		end)
		if ok then return found end
		return nil
	end
	resolved = resolve(getService("ReplicatedStorage")) or resolve(playerRef())
	if resolved == nil or not isInstance(resolved) then
		return false, "remote not found: " .. target
	end
	local ok, result = coreCall("RoutedFire", resolved, table.unpack(args, 2))
	if not ok then
		return false, result
	end
	return true, result
end)

