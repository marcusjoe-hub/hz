function Panel.render(): string
	local link = State.link
	local caps = Capabilities.get()
	local route = Route.read()
	local width = 78
	local lines: { string } = {}
	local function rule(title: string)
		lines[#lines + 1] = string.rep("-", width)
		if title ~= "" then
			lines[#lines + 1] = "  " .. title
		end
	end

	lines[#lines + 1] = string.rep("=", width)
	lines[#lines + 1] = "  HZ-2  ::  CONTROL PANEL"
	lines[#lines + 1] = string.rep("=", width)
	lines[#lines + 1] = string.format("  link      : %s (tier=%s, %d methods%s)",
		if link.linked then "LINKED" else "STANDALONE",
		link.tier,
		link.methods,
		if link.coreVersion then ", core v" .. link.coreVersion else "")
	if #link.missing > 0 then
		lines[#lines + 1] = "  missing   : " .. Text.cut(table.concat(link.missing, ", "), 60)
	end
	lines[#lines + 1] = string.format("  uptime    : %s", Text.ms(Clock.now() - ORIGIN))
	lines[#lines + 1] = string.format("  place     : %s   job: %s", tostring(route.placeId), tostring(route.jobId))
	lines[#lines + 1] = string.format("  player    : %s (uid %s)  team: %s",
		tostring(route.displayName or route.userName),
		tostring(route.userId),
		tostring(route.team))
	lines[#lines + 1] = string.format("  caps      : %d/%d present (%.1f%%)",
		caps.detected, caps.total, caps.coverage)

	rule("attributes")
	local rows = Attr.List()
	if #rows == 0 then
		lines[#lines + 1] = "    (none tracked -- run :attrall)"
	end
	for index, row in ipairs(rows) do
		if index > 14 then
			lines[#lines + 1] = string.format("    ... %d more", #rows - 14)
			break
		end
		lines[#lines + 1] = string.format("    %s %-20s = %-30s chg=%d",
			if row.priority then "*" else " ",
			row.name,
			Text.cut(Text.describe(row.value, 30), 30),
			row.changes)
	end

	if link.linked and State.core ~= nil then
		rule("core metrics")
		local okMetrics, metrics = pcall(function(): any
			return (State.core :: any).Metrics()
		end)
		if okMetrics and type(metrics) == "table" then
			local m: any = metrics
			lines[#lines + 1] = string.format(
				"    records=%s buffered=%s dropped=%s errors=%s",
				Text.group(m.records or 0), tostring(m.buffered), tostring(m.dropped), tostring(m.errors))
			lines[#lines + 1] = string.format(
				"    remotes=%s fire=%s invoke=%s inbound=%s wraps=%s",
				tostring(m.remotes),
				Text.group((m.counters or {}).fireCalls or 0),
				Text.group((m.counters or {}).invokeCalls or 0),
				Text.group((m.counters or {}).inboundEvents or 0),
				tostring((m.counters or {}).remoteWraps or 0))
			lines[#lines + 1] = string.format("    integrity=%s",
				if m.integrity then "VERIFIED" else "BREAK DETECTED")
		else
			lines[#lines + 1] = "    (metrics unavailable)"
		end
	end

	rule("commands")
	lines[#lines + 1] = "    " .. Text.cut(table.concat((function()
		local names: { string } = {}
		for _, key in ipairs(order) do
			names[#names + 1] = ":" .. key
		end
		return names
	end)(), " "), 300)

	lines[#lines + 1] = string.rep("=", width)
	return table.concat(lines, "\n")
end

--================================================================================
-- SECTION 11 :: PUBLIC API
--================================================================================

local API: HzControlAPI

--- Built as a local, then wired onto the API table. Self-referencing through
--- `API.x` before the table is assigned is an infinite recursion.
local function buildSnapshot(): Snapshot
	local coreSnapshot: { [string]: any }? = nil
	if State.link.linked then
		local okMetrics, metrics = pcall(function(): any
			return (State.core :: any).Metrics()
		end)
		if okMetrics and type(metrics) == "table" then
			coreSnapshot = metrics :: { [string]: any }
		end
	end
	return {
		link = State.link,
		caps = Capabilities.get(),
		attributes = Attr.List(),
		route = Route.read(),
		core = coreSnapshot,
		uptime = Clock.now() - ORIGIN,
	}
end

API = {
	Mount = function(handle: any?): LinkState
		local ok, result = pcall(Link.mount, handle)
		if not ok then
			say("error", "mount failed: " .. tostring(result))
			return State.link
		end
		return result
	end,

	Unlink = function(): ()
		pcall(Link.unlink)
	end,

	Link = function(): LinkState
		return State.link
	end,

	Core = function(): any
		return State.core
	end,

	Snapshot = function(): Snapshot
		local ok, result = pcall(buildSnapshot)
		if ok and type(result) == "table" then
			return result
		end
		say("error", "snapshot failed: " .. tostring(result))
		return {
			link = State.link,
			caps = Capabilities.get(),
			attributes = {},
			route = {},
			core = nil,
			uptime = Clock.now() - ORIGIN,
		}
	end,

	Panel = function(): string
		return panelText()
	end,

	Report = function(): string
		if State.link.linked then
			local ok, result = pcall(function(): any
				return (State.core :: any).Report()
			end)
			if ok and type(result) == "string" then
				return result
			end
		end
		return panelText()
	end,

	Attr = {
		Watch = function(name: string): boolean
			local ok, result = pcall(Attr.Watch, name)
			return ok and result == true
		end,
		Unwatch = function(name: string): boolean
			local ok, result = pcall(Attr.Unwatch, name)
			return ok and result == true
		end,
		WatchAll = function(): number
			local ok, result = pcall(Attr.WatchAll)
			if ok and type(result) == "number" then
				return result
			end
			return 0
		end,
		List = function(): { AttributeRecord }
			local ok, result = pcall(Attr.List)
			if ok and type(result) == "table" then
				return result
			end
			return {}
		end,
		Get = function(name: string): any
			local ok, result = pcall(Attr.Get, name)
			if ok then
				return result
			end
			return nil
		end,
		On = function(name: string, callback: (AttributeRecord) -> ()): any
			local ok, result = pcall(Attr.On, name, callback)
			if ok then
				return result
			end
			return nil
		end,
		Off = function(token: any): ()
			pcall(Attr.Off, token)
		end,
		Poll = function(): number
			local ok, result = pcall(Attr.Poll)
			if ok and type(result) == "number" then
				return result
			end
			return 0
		end,
	},

	SetPriority = function(names: { string }): ()
		if type(names) ~= "table" then
			return
		end
		Config.priorityKeys = names
		rebuildPriority()
		for _, record in pairs(State.attributes) do
			record.priority = isPriority(record.name)
		end
	end,

	AddPriority = function(name: string): ()
		if type(name) ~= "string" or name == "" then
			return
		end
		Config.priorityKeys[#Config.priorityKeys + 1] = name
		rebuildPriority()
	end,

	Route = function(): { [string]: any }
		local ok, result = pcall(Route.read)
		if ok and type(result) == "table" then
			return result
		end
		return {}
	end,

	Caps = function(): CapabilityReport
		return Capabilities.get()
	end,

	Exec = function(line: string): (boolean, any)
		local ok, first, second = pcall(Commands.exec, line)
		if not ok then
			return false, tostring(first)
		end
		return first == true, second
	end,

	Commands = function(): { Command }
		return Commands.list()
	end,

	Register = function(name: string, desc: string, usage: string, fn: (args: { string }) -> (boolean, any)): boolean
		return Commands.register(name, desc, usage, fn)
	end,

	Config = function(): { [string]: any }
		return table.clone(Config)
	end,

	Configure = function(overrides: { [string]: any }): boolean
		local ok = pcall(function()
			for key, value in pairs(overrides) do
				(Config :: any)[key] = value
			end
			rebuildPriority()
			capabilityCache = nil
		end)
		if not ok then
			return false
		end
		return true
	end,
}

--================================================================================
-- SECTION 12 :: SELF-CONTAINED EXECUTION
--================================================================================
-- The main chunk is vararg, so `loadstring(game:HttpGet(HZ2_URL))(core)` delivers
-- a /hz-1 handle with no global read at all. Fall through the tiers otherwise.

-- Capture the chunk's varargs ONCE at top level; a nested closure cannot use `...`.
local injectedHandle: any = ...
local mountOk, mountErr = pcall(function()
	Link.mount(injectedHandle)
end)
if not mountOk then
	State.consoleErrors += 1
	say("error", "mount contained failure: " .. tostring(mountErr))
end

--- Publish the companion handle for a future /hz-3. This is the single shared
--- state write in the module and can be disabled with Configure({ publishRegistry = false }).
if Config.publishRegistry then
	pcall(function()
		publishGlobal(Config.registryKey, API)
	end)
end

--- Poll thread: attribute discovery and deferred-watch recovery.
if taskFn ~= nil and Config.pollInterval > 0 then
	local okSpawn = pcall(function()
		State.pollThread = taskFn.spawn(function()
			while State.running do
				taskFn.wait(Config.pollInterval)
				pcall(Attr.Poll)
			end
		end)
	end)
	if not okSpawn then
		say("debug", "poll thread unavailable; :attrall remains manual")
	end
end

say("info", string.format("hz-2 ready | mode=%s | commands=%d | caps=%d/%d",
	if State.link.linked then "linked" else "standalone",
	#Commands.list(),
	Capabilities.get().detected,
	Capabilities.get().total))

return API
