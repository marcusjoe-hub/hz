--- Register a third-party command. Presented so downstream modules (/hz-3 and
--- beyond) extend the panel without forking this file.
function Commands.register(name: string, desc: string, usage: string, fn: (args: { string }) -> (boolean, any)): boolean
	if type(name) ~= "string" or name == "" or type(fn) ~= "function" then
		return false
	end
	define(name, desc, usage, fn)
	return true
end

function Commands.list(): { Command }
	local out: { Command } = {}
	for _, key in ipairs(order) do
		local command = registry[key]
		if command ~= nil then
			out[#out + 1] = command
		end
	end
	return out
end

--- Parse and dispatch. Quoted tokens are supported so arguments may contain
--- spaces. Every command runs inside its own containment boundary.
function Commands.exec(line: string): (boolean, any)
	if type(line) ~= "string" or line == "" then
		return false, "empty command"
	end
	-- Tokenise with a SINGLE positional capture. A multi-capture gmatch cannot work
	-- here: in a generic for, a nil first value terminates the loop, and an
	-- unmatched alternative yields nil by definition.
	local tokens: { string } = {}
	local position = 1
	while position <= #line do
		local openQuote = string.find(line, "\"", position, true)
		local firstWord = string.find(line, "%S", position)
		if firstWord == nil then
			break
		end
		if openQuote ~= nil and openQuote <= firstWord then
			local closeQuote = string.find(line, "\"", openQuote + 1, true)
			if closeQuote == nil then
				tokens[#tokens + 1] = string.sub(line, openQuote + 1)
				break
			end
			tokens[#tokens + 1] = string.sub(line, openQuote + 1, closeQuote - 1)
			position = closeQuote + 1
		else
			local stop = string.find(line, "%s", firstWord)
			if stop == nil then
				tokens[#tokens + 1] = string.sub(line, firstWord)
				break
			end
			tokens[#tokens + 1] = string.sub(line, firstWord, stop - 1)
			position = stop
		end
	end
	if #tokens == 0 then
		return false, "no command"
	end
	local name = string.lower(tokens[1])
	if string.sub(name, 1, 1) == ":" then
		name = string.sub(name, 2)
	end
	local command = registry[name]
	if command == nil then
		return false, "unknown command '" .. name .. "' (try :help)"
	end
	local args: { string } = {}
	for index = 2, #tokens do
		args[#args + 1] = tokens[index]
	end
	local ok, first, second = pcall(command.run, args)
	if not ok then
		say("error", string.format("command '%s' raised: %s", name, tostring(first)))
		return false, first
	end
	return first == true, second
end

