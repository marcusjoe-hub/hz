local Route = {}

local function probe(owner: any, property: string): any
	if owner == nil then
		return nil
	end
	local ok, value = pcall(function(): any
		return (owner :: any)[property]
	end)
	if ok then
		return value
	end
	return nil
end

function Route.read(): { [string]: any }
	local player = playerRef()
	local out: { [string]: any } = {
		placeId = probe(gameRef, "PlaceId"),
		gameId = probe(gameRef, "GameId"),
		jobId = probe(gameRef, "JobId"),
		placeVersion = probe(gameRef, "PlaceVersion"),
		userId = probe(player, "UserId"),
		userName = probe(player, "Name"),
		displayName = probe(player, "DisplayName"),
		elapsed = Clock.now() - ORIGIN,
	}

	if Services.RunService ~= nil then
		local okStudio, isStudio = pcall(function(): any
			return (Services.RunService :: any):IsStudio()
		end)
		if okStudio and type(isStudio) == "boolean" then
			out.isStudio = isStudio
		end
	end

	if player ~= nil then
		local okTeam, team = pcall(function(): any
			return (player :: any).Team
		end)
		if okTeam and team ~= nil then
			local okName, teamName = pcall(function(): any
				return (team :: any).Name
			end)
			if okName and type(teamName) == "string" then
				out.team = teamName
			end
			local okColor, color = pcall(function(): any
				return (team :: any).TeamColor
			end)
			if okColor and color ~= nil then
				out.teamColor = Text.describe(color, 40)
			end
		end
	end
	return out
end

--================================================================================
-- SECTION 8 :: CORE LINK (three-tier mount)
--================================================================================

local Link = {}

--- Method expectations. `Console` is a TABLE on /hz-1 (SetANSI / SetRateLimit / Rule),
--- not a function: checking it with `type(x) == "function"` mis-links a healthy core.
local EXPECTED_METHODS: { string } = {
	"IsRunning", "Report", "Metrics", "Audit", "Verify", "Route", "Attributes",
	"WatchAttribute", "TrackRemote", "Boot", "Shutdown", "Dump", "Teleports",
	"Sessions", "Search", "Scan",
}

local function memberPresent(candidate: any, name: string): boolean
	local ok, value = pcall(function(): any
		return (candidate :: any)[name]
	end)
	if not ok or value == nil then
		return false
	end
	if name == "Console" then
		return type(value) == "table"
	end
	return type(value) == "function"
end

local function looksLikeCore(candidate: any): boolean
	if type(candidate) ~= "table" then
		return false
	end
	if type((candidate :: any).Report) ~= "function" then
		return false
	end
	if type((candidate :: any).Metrics) ~= "function" then
		return false
	end
	return true
end

local function inspect(candidate: any, tier: string): LinkState
	local missing: { string } = {}
	local present = 0
	for _, name in ipairs(EXPECTED_METHODS) do
		if memberPresent(candidate, name) then
			present += 1
		else
			missing[#missing + 1] = name
		end
	end
	local version: string? = nil
	local okVersion, versionValue = pcall(function(): any
		local metrics = (candidate :: any).Metrics()
		if type(metrics) == "table" then
			return (metrics :: any).version
		end
		return nil
	end)
	if okVersion and type(versionValue) == "string" then
		version = versionValue
	end
	-- `Console` is validated separately; it is required but is not a callable member.
	local consoleOk = memberPresent(candidate, "Console")
	return {
		linked = present == #EXPECTED_METHODS and consoleOk,
		tier = tier,
		methods = present,
		missing = missing,
		coreVersion = version,
	}
end

local function fromRegistry(): any
	local readers: { { name: string, get: () -> any } } = {
		{
			name = "getgenv",
			get = function(): any
				local fn = resolveGlobal("getgenv")
				if type(fn) ~= "function" then
					return nil
				end
				local ok, env = pcall(fn)
				if ok and type(env) == "table" then
					return (env :: any).hz1
				end
				return nil
			end,
		},
		{ name = "_G", get = function(): any
			return (_G :: any).hz1
		end },
		{ name = "shared", get = function(): any
			return (shared :: any).hz1
		end },
	}
	for _, reader in ipairs(readers) do
		local ok, candidate = pcall(reader.get)
		if ok and looksLikeCore(candidate) then
			say("info", "registry hit via " .. reader.name .. ".hz1")
			return candidate
		end
	end
	return nil
end

local function selfFetch(): any
	if not Config.autoLoadCore then
		return nil
	end
	local httpGet = resolveGlobal("HttpGet")
	if type(httpGet) ~= "function" then
		say("warn", "no core handle and HttpGet is unavailable; running standalone")
		return nil
	end
	local okFetch, source = pcall(httpGet, Config.coreUrl)
	if not okFetch or type(source) ~= "string" then
		say("warn", "self-fetch of /hz-1 failed: " .. tostring(source))
		return nil
	end
	local loader: any = resolveGlobal("loadstring")
	if loader == nil then
		loader = resolveGlobal("load")
	end
	if type(loader) ~= "function" then
		say("warn", "loadstring unavailable; cannot self-fetch /hz-1")
		return nil
	end
	local okCompile, chunk = pcall(loader, source, "=hz-1")
	if not okCompile or type(chunk) ~= "function" then
		say("warn", "compile of /hz-1 failed: " .. tostring(chunk))
		return nil
	end
	local okRun, api = pcall(chunk)
	if not okRun or not looksLikeCore(api) then
		say("warn", "execution of /hz-1 failed: " .. tostring(api))
		return nil
	end
	say("info", "self-fetched and booted /hz-1")
	return api
end

function Link.mount(handle: any?): LinkState
	local candidate: any = handle
	local tier = "argument"

	if not looksLikeCore(candidate) then
		candidate = fromRegistry()
		tier = "registry"
	end
	if not looksLikeCore(candidate) then
		candidate = selfFetch()
		tier = "self-fetch"
	end

	if not looksLikeCore(candidate) then
		State.core = nil
		State.link = {
			linked = false,
			tier = "standalone",
			methods = 0,
			missing = EXPECTED_METHODS,
			coreVersion = nil,
		}
		say("warn", "standalone mode: attribute surveillance and route reflection remain active")
		return State.link
	end

	State.core = candidate
	State.link = inspect(candidate, tier)
	say("info", string.format("core linked via %s (v%s, %d/%d methods)",
		tier,
		tostring(State.link.coreVersion),
		State.link.methods,
		#EXPECTED_METHODS))

	if not memberPresent(candidate, "Console") then
		State.link.missing[#State.link.missing + 1] = "Console"
	end
	if #State.link.missing > 0 then
		say("warn", "core is missing: " .. table.concat(State.link.missing, ", "))
	end

	-- Re-attach the core watcher for anything already tracked locally.
	pcall(function()
		for _, record in pairs(State.attributes) do
			if type((candidate :: any).WatchAttribute) == "function" then
				(candidate :: any).WatchAttribute(record.name)
			end
		end
	end)

	return State.link
end

function Link.unlink(): ()
	if State.core ~= nil then
		pcall(function()
			local core = asAny(State.core)
			if type(core) == "table" and type(core.UnwatchAttribute) == "function" then
				for _, record in pairs(State.attributes) do
					(core.UnwatchAttribute :: any)(record.name)
				end
			end
		end)
	end
	State.core = nil
	State.link = {
		linked = false,
		tier = "standalone",
		methods = 0,
		missing = EXPECTED_METHODS,
		coreVersion = nil,
	}
	say("info", "detached from /hz-1; continuing standalone")
end

