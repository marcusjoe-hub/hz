-- Every global and service is probed, never dereferenced blind. A restricted or
-- partially sandboxed client can present any of these as absent or locked.

local typeofGlobal: any = nil
do
	local ok, resolved = pcall(function(): any
		return typeof
	end)
	if ok then
		typeofGlobal = resolved
	end
end

local gameRef: any = nil
do
	local ok, resolved = pcall(function(): any
		return game
	end)
	if ok and type(resolved) == "table" then
		gameRef = resolved
	end
end

local taskLib: any = nil
do
	local ok, resolved = pcall(function(): any
		return task
	end)
	if ok and type(resolved) == "table" then
		taskLib = resolved
	end
end

local function getService(name: string): any
	if gameRef == nil then
		return nil
	end
	local ok, service = pcall(function(): any
		return (gameRef :: any):GetService(name)
	end)
	if ok and service ~= nil then
		return service
	end
	return nil
end

local Services = {
	Players = getService("Players"),
	RunService = getService("RunService"),
	ReplicatedStorage = getService("ReplicatedStorage"),
	ReplicatedFirst = getService("ReplicatedFirst"),
	TeleportService = getService("TeleportService"),
	HttpService = getService("HttpService"),
	LogService = getService("LogService"),
	Workspace = getService("Workspace"),
}

local workspaceRef: any = Services.Workspace
if workspaceRef == nil then
