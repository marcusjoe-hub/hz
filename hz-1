--================================================================================
-- SECTION 7 :: SERIALISATION (verbose, redacting, cycle-safe, budgeted)
--================================================================================

local Serialiser = {}

local REDACT_PLACEHOLDER = "<redacted>"

local function shouldRedact(key: any): boolean
	if not Config.redact.enabled then
		return false
	end
	if type(key) ~= "string" then
		return false
	end
	local lowered = string.lower(key)
	if Config.redact.keys[lowered] then
		return true
	end
	for name in pairs(Config.redact.keys) do
		if string.find(lowered, name, 1, true) ~= nil then
			return true
		end
	end
	return false
end

--- Type label that prefers the engine's `typeof` when present, falling back to
--- a class-name sniff for userdata so typed objects stay readable.
function Serialiser.typeOf(value: any): string
	if value == nil then
		return "nil"
	end
	local label = engineTypeof(value)
	if label ~= nil then
		return label
	end
	local basic = type(value)
	if basic == "userdata" then
		local ok, className = pcall(function(): any
			return (value :: any).ClassName
		end)
		if ok and type(className) == "string" then
			return "userdata:" .. className
		end
	end
	return basic
end

local function escapeString(text: string, multiline: boolean): string
	local clipped = text
	if #clipped > Config.limits.maxStringChars then
		clipped = string.sub(clipped, 1, Config.limits.maxStringChars)
			.. "..(" .. tostring(#text - Config.limits.maxStringChars) .. "b more)"
	end
	if multiline then
		clipped = Util.stripControl(clipped)
	else
		clipped = (string.gsub(Util.stripControl(clipped), "\n", "\\n"))
	end
	return '"' .. clipped .. '"'
end

function Serialiser.describe(value: any, budgetChars: number?): string
	local budget = { remaining = budgetChars or Config.console.payloadPreviewChars }

	local function enc(inner: any, depth: number, seen: { [any]: boolean }, key: any): string
		if budget.remaining <= 0 then
			return "~"
		end
		if key ~= nil and shouldRedact(key) then
			budget.remaining -= #REDACT_PLACEHOLDER
			return '"' .. REDACT_PLACEHOLDER .. '"'
		end
		if inner == nil then
			budget.remaining -= 1
			return "nil"
		end
		local basic = type(inner)
		if basic == "boolean" then
			budget.remaining -= 1
			return if inner then "true" else "false"
		end
		if basic == "number" then
			budget.remaining -= 1
			if inner ~= inner then
				return "nan"
			end
			if inner == math.huge then
				return "inf"
			end
			if inner == -math.huge then
				return "-inf"
			end
			return string.format("%.6g", inner)
		end
		if basic == "string" then
			budget.remaining -= #inner + 2
			return escapeString(inner, Config.console.multilinePayloads)
		end
		if basic == "table" then
			if seen[inner] then
				return "<cycle>"
			end
			if depth > Config.limits.maxDepth then
				return "<depth:" .. tostring(depth) .. ">"
			end
			seen[inner] = true
			local parts: { string } = {}
			local arrayCount = 0
			for _ in pairs(inner) do
				arrayCount += 1
				if arrayCount > Config.limits.maxKeys then
					break
				end
			end
			for item, entry in pairs(inner) do
				if budget.remaining <= 0 then
					parts[#parts + 1] = "..."
					break
				end
				local label: string
				if type(item) == "string" then
					label = item
				elseif type(item) == "number" then
					label = tostring(item)
				else
					label = "[" .. Serialiser.typeOf(item) .. "]"
				end
				parts[#parts + 1] = label .. "=" .. enc(entry, depth + 1, seen, item)
				if #parts >= Config.limits.maxKeys then
					parts[#parts + 1] = "..."
					break
				end
			end
			seen[inner] = nil
			budget.remaining -= 2
			return "{" .. table.concat(parts, ", ") .. "}"
		end
		budget.remaining -= 16
		return "<" .. Serialiser.typeOf(inner) .. ">"
	end

	local ok, result = pcall(enc, value, 1, {}, nil)
	if ok and type(result) == "string" then
		return result
	end
	return "<unserialisable:" .. Serialiser.typeOf(value) .. ">"
end

--- Compact one-line signature for an argument list, e.g. "3 args [string, table, number]".
function Serialiser.signature(packed: PackedArgs): string
	local count = packed.n
	if count == 0 then
		return "0 args []"
	end
	local labels: { string } = {}
	local shown = math.min(count, 8)
	for index = 1, shown do
		labels[index] = Serialiser.typeOf(packed[index])
	end
	if count > shown then
		labels[#labels + 1] = "+" .. tostring(count - shown)
	end
	return tostring(count) .. " args [" .. table.concat(labels, ", ") .. "]"
end

function Serialiser.estimateBytes(packed: PackedArgs): number
	local total = 0
	for index = 1, packed.n do
		local value = packed[index]
		local basic = type(value)
		if basic == "string" then
			total += #value
		elseif basic == "number" then
			total += 8
		elseif basic == "boolean" then
			total += 1
		elseif basic == "table" then
			total += #Serialiser.describe(value, 96)
		else
			total += 16
		end
	end
	return total
end

--================================================================================
-- SECTION 8 :: CONSOLE OUTPUT ENGINE
--================================================================================

local Console = {}

local consoleBudget = {
	windowStart = 0,
	sent = 0,
	suppressed = 0,
	lastFlush = 0,
}

local function timestampPrefix(): string
	if not Config.console.timestamp then
		return ""
	end
	local wall = Clock.wall()
	local seconds = wall % 86400
	local hours = math.floor(seconds / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	local secs = seconds % 60
	return string.format("%02d:%02d:%05.2f ", hours, minutes, secs)
end

--- Pretty single-line audit row. Colour is applied only when ANSI is enabled,
--- because the Studio output pane renders escape codes literally.
function Console.formatRow(level: LogLevel, channel: Channel, event: string, tag: string, detail: string): string
	local parts: { string } = {}

	if Config.console.ansi then
		local tint = LEVEL_ANSI[level] or ANSI.white
		local chanTint = CHANNEL_ANSI[channel] or ANSI.white
		parts[#parts + 1] = ANSI.dim .. timestampPrefix() .. ANSI.reset
		parts[#parts + 1] = tint .. ANSI.bold .. Util.padEnd(string.upper(channel), CHANNEL_WIDTH) .. ANSI.reset
		parts[#parts + 1] = tint .. Util.padEnd(string.upper(level), LEVEL_WIDTH) .. ANSI.reset
		parts[#parts + 1] = chanTint .. Util.padEnd(Util.truncate(event, EVENT_WIDTH), EVENT_WIDTH) .. ANSI.reset
		if tag ~= "" then
			parts[#parts + 1] = ANSI.cyan .. "@" .. Util.truncate(tag, 42) .. ANSI.reset
		end
		parts[#parts + 1] = ANSI.dim .. "|" .. ANSI.reset
		parts[#parts + 1] = detail
	else
		local stamp = timestampPrefix()
		if stamp ~= "" then
			parts[#parts + 1] = stamp
		end
		parts[#parts + 1] = "[" .. Util.padEnd(string.upper(channel), CHANNEL_WIDTH) .. "]"
		parts[#parts + 1] = Util.padEnd(string.upper(level), LEVEL_WIDTH)
		parts[#parts + 1] = Util.padEnd(Util.truncate(event, EVENT_WIDTH), EVENT_WIDTH)
		if tag ~= "" then
			parts[#parts + 1] = "@" .. Util.truncate(tag, 42)
		end
		parts[#parts + 1] = "| " .. detail
	end

	return table.concat(parts, " ")
end

--- Rate governor. Keeps the console readable under packet floods without ever
--- dropping the audit trail: records still land in the ring buffer.
local function allowConsole(): boolean
	local now = Clock.elapsed()
	if now - consoleBudget.windowStart >= 1 then
		consoleBudget.windowStart = now
		consoleBudget.sent = 0
		consoleBudget.suppressed = 0
	end
	if consoleBudget.sent < Config.console.rateLimitPerSecond then
		consoleBudget.sent += 1
		return true
	end
	consoleBudget.suppressed += 1
	return false
end

local function flushSuppressed(): ()
	if consoleBudget.suppressed <= 0 then
		return
	end
	local count = consoleBudget.suppressed
	consoleBudget.suppressed = 0
	local message = string.format("%s[THROTTLED]%s %d audit line(s) suppressed by rate limit (%d/s); all records still buffered.",
		if Config.console.ansi then ANSI.yellow else "",
		if Config.console.ansi then ANSI.reset else "",
		count,
		Config.console.rateLimitPerSecond
	)
	pcall(function()
		print(message)
	end)
end

Console.emit = function(level: LogLevel, channel: Channel, event: string, tag: string, detail: string): ()
	local line = Console.formatRow(level, channel, event, tag, detail)
	if not allowConsole() then
		return
	end
	local isWarning = level == "warn" or level == "error"
	-- print() for the white/informational channels; warn() for warn/error, which
	-- Studio renders in amber. This is the only colour channel Roblox provides.
	local ok = pcall(function()
		if isWarning then
			warn(line)
		else
			print(line)
		end
	end)
	if ok then
		flushSuppressed()
	end
end

Console.rule = function(title: string): ()
	local bar = string.rep("=", 78)
	local line = string.format("%s\n  %s\n%s", bar, title, bar)
	pcall(function()
		print(if Config.console.ansi then ANSI.cyan .. line .. ANSI.reset else line)
	end)
end

Console.SetANSI = function(enabled: boolean): ()
	Config.console.ansi = enabled == true
end

Console.SetRateLimit = function(perSecond: number): ()
	Config.console.rateLimitPerSecond = math.max(1, math.floor(perSecond))
end

--================================================================================
-- SECTION 9 :: HASH-CHAINED AUDIT RING
--================================================================================
-- Every emitted record is chained: record.hash = FNV1a(prevHash, seq|clock|body).
-- Verify() walks the retained window from an anchor so the chain stays checkable
-- after eviction.

local AuditRing = {}
AuditRing.__index = AuditRing

type RingState = {
	_capacity: number,
	_slots: { [number]: StoredRecord },
	_head: number,
	_tail: number,
	_count: number,
	_total: number,
	_dropped: number,
	_chainTip: number,
	_anchor: number,
}

function AuditRing.new(capacity: number): RingState
	local self: any = setmetatable({}, AuditRing)
	self._capacity = math.max(1, math.floor(capacity))
	self._slots = {}
	self._head = 0
	self._tail = 0
	self._count = 0
	self._total = 0
	self._dropped = 0
	self._chainTip = FNV_OFFSET
	self._anchor = FNV_OFFSET
	return self
end

function AuditRing.append(self: RingState, record: StoredRecord): StoredRecord
	local capacity = self._capacity
	self._head += 1
	if self._head > capacity then
		self._head = 1
	end
	if self._count >= capacity then
		local evicted = self._slots[self._head]
		if evicted ~= nil then
			self._anchor = evicted.hash
		end
		self._tail += 1
		if self._tail > capacity then
			self._tail = 1
		end
		self._dropped += 1
	else
		self._count += 1
		if self._count == 1 then
			self._tail = self._head
		end
	end
	record.prevHash = self._chainTip
	record.hash = Util.fnv1a(
		tostring(record.seq) .. "|" .. tostring(record.clock) .. "|" .. record.event .. "|" .. record.body,
		record.prevHash
	)
	self._chainTip = record.hash
	self._slots[self._head] = record
	self._total = record.seq
	return record
end

function AuditRing.get(self: RingState, index: number): StoredRecord?
	if index < 1 or index > self._count then
		return nil
	end
	local slot = self._tail + index - 1
	if slot > self._capacity then
		slot -= self._capacity
	end
	return self._slots[slot]
end

function AuditRing.size(self: RingState): number
	return self._count
end

function AuditRing.total(self: RingState): number
	return self._total
end

function AuditRing.dropped(self: RingState): number
	return self._dropped
end

function AuditRing.anchor(self: RingState): number
	return self._anchor
end

function AuditRing.clear(self: RingState): ()
	self._slots = {}
	self._head, self._tail, self._count = 0, 0, 0
	self._chainTip = FNV_OFFSET
	self._anchor = FNV_OFFSET
end

--================================================================================
-- SECTION 10 :: ENGINE STATE
--================================================================================

local Engine = {
	running = false,
	booting = false,
	ring = AuditRing.new(DefaultConfig.ringCapacity),
	session = "",
	startedClock = 0,
	seq = 0,
	errors = 0,
	consoleErrors = 0,

	remotes = {} :: { [RemoteStats]: RemoteStats },
	remoteByInstance = {} :: { [InstanceRef]: RemoteStats },
	remoteByPath = {} :: { [string]: RemoteStats },
	originals = {} :: { [InstanceRef]: { [string]: any } },
	guards = {} :: { [InstanceRef]: { [string]: boolean } },
	connections = {} :: { any },
	scanConns = {} :: { any },

	attributes = {} :: { [string]: AttributeWatch },
	attributeConns = {} :: { [string]: any },
	attributePollThread = nil :: any,

	route = {} :: RouteSnapshot,
	teleports = {} :: { TeleportRecord },
	sessions = {} :: { SessionEvent },

	metrics = ({} :: any) :: { [string]: number },
}

--- Counters are pre-seeded so reports never surface an optional field.
do
	local seed: { [string]: number } = {
		recordsEmitted = 0,
		recordsDropped = 0,
		remoteWraps = 0,
		remoteWrapDenials = 0,
		fireCalls = 0,
		invokeCalls = 0,
		inboundEvents = 0,
		inboundInvokes = 0,
		attributeChanges = 0,
		routeEvents = 0,
		bootAt = 0,
	}
	for name, value in pairs(seed) do
		Engine.metrics[name] = value
	end
end

local function counter(name: string, delta: number?): ()
	Engine.metrics[name] = (Engine.metrics[name] or 0) + (delta or 1)
end

--================================================================================
-- SECTION 11 :: RECORD EMISSION
--================================================================================

local function sanitiseTag(tag: string): string
	return Util.stripControl(Util.truncate(tag, 120))
end

--- The single choke point for every record. Emits to console AND buffer inside a
--- containment boundary: a serialiser failure degrades one record, never the host.
local function emit(level: LogLevel, channel: Channel, event: string, tag: string, payload: any, detailOverride: string?): ()
	local ok, err = pcall(function()
		local cleanTag = sanitiseTag(tag)
		local detail = Util.stripControl(
			detailOverride or Serialiser.describe(payload, Config.console.payloadPreviewChars)
		)

		Console.emit(level, channel, event, cleanTag, detail)

		local body = channel .. "|" .. event .. "|" .. cleanTag .. "|" .. detail
		local seq = Engine.seq + 1
		Engine.seq = seq
		local record: StoredRecord = {
			seq = seq,
			clock = Clock.elapsed(),
			wall = Clock.wall(),
			channel = channel,
			level = level,
			event = event,
			tag = cleanTag,
			hash = 0,
			prevHash = 0,
			size = #body,
			body = body,
		}
		AuditRing.append(Engine.ring, record)
		Engine.metrics.recordsEmitted += 1
		Engine.metrics.recordsDropped = AuditRing.dropped(Engine.ring)
		if level == "error" then
			Engine.errors += 1
		end
	end)
	if not ok then
		Engine.consoleErrors += 1
		-- Last-resort containment. The engine must survive its own telemetry.
		pcall(function()
			print("[DCORE] internal record failure: " .. tostring(err))
		end)
	end
end

--================================================================================
-- SECTION 12 :: LAYER A :: GLOBAL NETWORK INTERCEPTOR
--================================================================================

local Network = {}

local EVENT_CLASSES: { [string]: boolean } = {
	RemoteEvent = true,
	UnreliableRemoteEvent = true,
}

local FUNCTION_CLASS = "RemoteFunction"

local function classNameOf(instance: any): string?
	local label = engineTypeof(instance)
	if label ~= nil and label ~= "Instance" then
		-- not an Instance at all; ClassName would error on a primitive
		return nil
	end
	local ok, className = pcall(function(): any
		return (instance :: any).ClassName
	end)
	if ok and type(className) == "string" then
		return className
	end
	return nil
end

local function fullPath(instance: any): string
	local ok, name = pcall(function(): any
		return (instance :: any):GetFullName()
	end)
	if ok and type(name) == "string" and name ~= "" then
		return name
	end
	local okName, short = pcall(function(): any
		return (instance :: any).Name
	end)
	if okName and type(short) == "string" then
		return short
	end
	return "<unnamed>"
end

local function newRemoteStats(instance: any, className: string): RemoteStats
	local stats: RemoteStats = {
		instance = instance,
		name = "",
		path = fullPath(instance),
		className = className,
		fireCalls = 0,
		invokeCalls = 0,
		receivedEvents = 0,
		receivedInvokes = 0,
		errors = 0,
		lastError = nil,
		bytesEstimated = 0,
		firstSeenClock = Clock.elapsed(),
		lastActivityClock = Clock.elapsed(),
		latencySamples = {},
		wrapFire = false,
		wrapInvoke = false,
		wrapInbound = false,
	}
	local ok, name = pcall(function(): any
		return (instance :: any).Name
	end)
	if ok and type(name) == "string" then
		stats.name = name
	end
	Engine.remotes[stats] = stats
	Engine.remoteByInstance[instance] = stats
	Engine.remoteByPath[stats.path] = stats
	return stats
end

local function noteActivity(stats: RemoteStats): ()
	stats.lastActivityClock = Clock.elapsed()
end

local function pushLatency(stats: RemoteStats, seconds: number): ()
	local samples = stats.latencySamples
	if #samples < Config.limits.latencySamples then
		samples[#samples + 1] = seconds
	else
		table.remove(samples, 1)
		samples[#samples + 1] = seconds
	end
end

local function describeArgs(packed: PackedArgs): string
	local parts: { string } = {}
	for index = 1, math.min(packed.n, 6) do
		parts[index] = Serialiser.describe(packed[index], 90)
	end
	if packed.n > 6 then
		parts[#parts + 1] = "..."
	end
	return "(" .. table.concat(parts, ", ") .. ")"
end

--- Observe inbound traffic. A listener is attached here, which means this engine
--- sees events it is connected to. Listeners owned by other scripts are outside
--- any client script's reach and are not claimed to be intercepted.
local function attachInbound(stats: RemoteStats): ()
	local instance = stats.instance
	if EVENT_CLASSES[stats.className] then
		local okSignal, signal = pcall(function(): any
			return (instance :: any).OnClientEvent
		end)
		if okSignal and signal ~= nil then
			local okConn, conn = pcall(function(): any
				return (signal :: any):Connect(function(...: any)
					local packed = safeArgs(...)
					local okp, err = pcall(function()
						stats.receivedEvents += 1
						counter("inboundEvents")
						noteActivity(stats)
						emit("info", "net", "recv.event", stats.path,
							string.format("<= %s %s", Serialiser.signature(packed), describeArgs(packed)))
					end)
					if not okp then
						stats.errors += 1
						emit("error", "net", "recv.event.error", stats.path, tostring(err))
					end
				end)
			end)
			if okConn and conn ~= nil then
				stats.wrapInbound = true
				Engine.scanConns[#Engine.scanConns + 1] = conn
			end
		end
	elseif stats.className == FUNCTION_CLASS then
		-- Inbound RemoteFunction observation is OPT-IN by necessity. If nothing is
		-- bound, installing our own observer would answer every server invoke with
		-- nil, which silently breaks game logic that expects a real return value.
		-- So: adopt an existing handler and pass its results through untouched;
		-- otherwise record that inbound observation is unavailable and move on.
		local okRead, existing = pcall(function(): any
			return (instance :: any).OnClientInvoke
		end)
		if not okRead then
			emit("warn", "net", "recv.invoke.unreadable", stats.path, tostring(existing))
			return
		end
		if type(existing) ~= "function" then
			emit("debug", "net", "recv.invoke.no-handler", stats.path,
				"no OnClientInvoke bound; inbound invoke observation skipped (non-invasive)")
			return
		end

		local okAssign, assignErr = pcall(function()
			(instance :: any).OnClientInvoke = function(...: any): any
				local packed = safeArgs(...)
				local okLog = pcall(function()
					stats.receivedInvokes += 1
					counter("inboundInvokes")
					noteActivity(stats)
					emit("info", "net", "recv.invoke", stats.path,
						string.format("<= %s %s (forwarded to game handler)",
							Serialiser.signature(packed), describeArgs(packed)))
				end)
				if not okLog then
					Engine.consoleErrors += 1
				end
				-- Errors from the game's own handler must propagate unchanged.
				return (asAny(existing) :: any)(table.unpack(packed, 1, packed.n))
			end
		end)
		if okAssign then
			stats.wrapInbound = true
			local bucket = Engine.originals[instance]
			if bucket == nil then
				bucket = {}
				Engine.originals[instance] = bucket
			end
			bucket.OnClientInvoke = existing
		else
			emit("warn", "net", "recv.invoke.locked", stats.path,
				"OnClientInvoke is read-only on this client: " .. tostring(assignErr))
		end
	end
end

local function wrapFireServer(stats: RemoteStats): boolean
	local instance = stats.instance
	local okRead, original = pcall(function(): any
		return (instance :: any).FireServer
	end)
	if not okRead or original == nil then
		emit("warn", "net", "wrap.read.failed", stats.path, "FireServer unreadable: " .. tostring(original))
		return false
	end

	local replacement = function(self: any, ...: any): ()
		local startedClock = Clock.elapsed()
		local packed = safeArgs(...)
		local okCall, callErr = pcall(function(): any
			return (asAny(original) :: any)(self, table.unpack(packed, 1, packed.n))
		end)
		local elapsed = Clock.elapsed() - startedClock

		local okTelemetry = pcall(function()
			stats.fireCalls += 1
			counter("fireCalls")
			noteActivity(stats)
			pushLatency(stats, elapsed)
			stats.bytesEstimated += Serialiser.estimateBytes(packed)
			if not okCall then
				stats.errors += 1
				stats.lastError = tostring(callErr)
			end
			local detail = string.format("=> %s %s  dispatch=%s%s",
				Serialiser.signature(packed),
				describeArgs(packed),
				Util.millis(elapsed),
				if okCall then "" else ("  ERROR=" .. tostring(callErr))
			)
			emit(if okCall then "info" else "error", "net", "send.fire", stats.path, nil, detail)
		end)

		if not okCall then
			error(callErr, 0)
		end
		if not okTelemetry then
			Engine.consoleErrors += 1
		end
	end

	local okWrite, writeErr = pcall(function()
		(instance :: any).FireServer = replacement
	end)
	if not okWrite then
		Engine.metrics.remoteWrapDenials += 1
		emit("warn", "net", "wrap.denied", stats.path,
			string.format("FireServer is locked on this instance (%s); use RoutedFire for call-site capture", tostring(writeErr)))
		return false
	end

	local bucket = Engine.originals[instance]
	if bucket == nil then
		bucket = {}
		Engine.originals[instance] = bucket
	end
	bucket.FireServer = original
	Engine.metrics.remoteWraps += 1
	return true
end

local function wrapInvokeServer(stats: RemoteStats): boolean
	local instance = stats.instance
	local okRead, original = pcall(function(): any
		return (instance :: any).InvokeServer
	end)
	if not okRead or original == nil then
		emit("warn", "net", "wrap.read.failed", stats.path, "InvokeServer unreadable: " .. tostring(original))
		return false
	end

	local replacement = function(self: any, ...: any): (boolean, any)
		local startedClock = Clock.elapsed()
		local packed = safeArgs(...)
		local results = safeArgs(pcall(function(): any
			return (asAny(original) :: any)(self, table.unpack(packed, 1, packed.n))
		end))
		local elapsed = Clock.elapsed() - startedClock
		local okCall = results[1] == true

		local okTelemetry = pcall(function()
			stats.invokeCalls += 1
			counter("invokeCalls")
			noteActivity(stats)
			pushLatency(stats, elapsed)
			stats.bytesEstimated += Serialiser.estimateBytes(packed)
			if not okCall then
				stats.errors += 1
				stats.lastError = tostring(results[2])
			end
			local detail = string.format("=> %s %s  rtt=%s%s",
				Serialiser.signature(packed),
				describeArgs(packed),
				Util.millis(elapsed),
				if okCall then "" else ("  ERROR=" .. tostring(results[2]))
			)
			emit(if okCall then "info" else "error", "net", "invoke.send", stats.path, nil, detail)
		end)

		if not okCall then
			error(results[2], 0)
		end
		if not okTelemetry then
			Engine.consoleErrors += 1
		end
		return table.unpack(results, 2, results.n)
	end

	local okWrite, writeErr = pcall(function()
		(instance :: any).InvokeServer = replacement
	end)
	if not okWrite then
		Engine.metrics.remoteWrapDenials += 1
		emit("warn", "net", "wrap.denied", stats.path,
			string.format("InvokeServer is locked on this instance (%s); use RoutedInvoke for call-site capture", tostring(writeErr)))
		return false
	end

	local bucket = Engine.originals[instance]
	if bucket == nil then
		bucket = {}
		Engine.originals[instance] = bucket
	end
	bucket.InvokeServer = original
	Engine.metrics.remoteWraps += 1
	return true
end

function Network.track(instance: any): boolean
	local className = classNameOf(instance)
	if className == nil then
		return false
	end
	local isEvent = EVENT_CLASSES[className] == true
	local isFunction = className == FUNCTION_CLASS
	if not isEvent and not isFunction then
		return false
	end
	if Engine.remoteByInstance[instance] ~= nil then
		return true
	end

	local stats = newRemoteStats(instance, className)

	local okGuard, guardErr = pcall(function()
		if Engine.guards[instance] == nil then
			Engine.guards[instance] = { destroyed = false }
		end
		local okConn, conn = pcall(function(): any
			return (instance :: any).Destroying:Connect(function()
				emit("warn", "net", "remote.destroyed", stats.path, "instance destroyed; telemetry row retained")
				Engine.remoteByInstance[instance] = nil
			end)
		end)
		if okConn and conn ~= nil then
			Engine.scanConns[#Engine.scanConns + 1] = conn
		end
	end)
	if not okGuard then
		emit("debug", "net", "guard.skipped", stats.path, tostring(guardErr))
	end

	if isEvent then
		if Config.scan.wrapFire then
			stats.wrapFire = wrapFireServer(stats)
		end
		if Config.scan.wrapInbound then
			attachInbound(stats)
		end
	else
		if Config.scan.wrapInvoke then
			stats.wrapInvoke = wrapInvokeServer(stats)
		end
		if Config.scan.wrapInbound then
			attachInbound(stats)
		end
	end

	emit("info", "net", "remote.tracked", stats.path,
		string.format("%s  fire=%s invoke=%s inbound=%s",
			className,
			tostring(stats.wrapFire),
			tostring(stats.wrapInvoke),
			tostring(stats.wrapInbound)
		)
	)
	return true
end

function Network.untrack(instance: any): boolean
	local stats = Engine.remoteByInstance[instance]
	if stats == nil then
		return false
	end
	local bucket = Engine.originals[instance]
	if bucket ~= nil then
		if bucket.FireServer ~= nil then
			pcall(function()
				(instance :: any).FireServer = bucket.FireServer
			end)
		end
		if bucket.InvokeServer ~= nil then
			pcall(function()
				(instance :: any).InvokeServer = bucket.InvokeServer
			end)
		end
		Engine.originals[instance] = nil
	end
	Engine.remoteByInstance[instance] = nil
	Engine.remotes[stats] = nil
	Engine.remoteByPath[stats.path] = nil
	emit("info", "net", "remote.untracked", stats.path,
		string.format("fire=%d invoke=%d errors=%d", stats.fireCalls, stats.invokeCalls, stats.errors))
	return true
end

local function collectRoots(): { any }
	local roots: { any } = {}
	for _, spec in ipairs(Config.scan.roots) do
		local resolved: any = nil
		if spec.class == "Player" then
			resolved = playerRef()
		elseif spec.name == "Workspace" then
			resolved = workspaceRef
		else
			resolved = Services[spec.name]
		end
		if resolved ~= nil then
			roots[#roots + 1] = resolved
			emit("debug", "net", "scan.root", spec.name, "root resolved")
		else
			emit("debug", "net", "scan.root.missing", spec.name, "root unavailable on this client; skipped")
		end
	end
	return roots
end

function Network.scan(): number
	local found = 0
	local visited = 0
	local roots = collectRoots()
	for _, root in ipairs(roots) do
		local okDescendants, descendants = pcall(function(): any
			return (root :: any):GetDescendants()
		end)
		if not okDescendants or type(descendants) ~= "table" then
			-- A locked or non-Instance root has no descendant walk. That is an
			-- environment property, not an engine fault: report it quietly and
			-- continue with the remaining roots.
			emit("debug", "net", "scan.root.no-descendants", fullPath(root), tostring(descendants))
			continue
		end
		for _, instance in ipairs(descendants :: { any }) do
			visited += 1
			local okTrack, tracked = pcall(Network.track, instance)
			if okTrack and tracked then
				found += 1
			end
		end
	end
	emit("info", "net", "scan.complete", "",
		string.format("visited=%d remotes=%d wraps=%d denied=%d",
			visited, found, Engine.metrics.remoteWraps, Engine.metrics.remoteWrapDenials))
	return found
end

--- Watch for remotes created after boot (streamed instances, lazy modules).
function Network.watchRoots(): ()
	if not Config.scan.watchNew then
		return
	end
	for _, root in ipairs(collectRoots()) do
		local okConn, conn = pcall(function(): any
			return (root :: any).DescendantAdded:Connect(function(descendant: any)
				local okTrack = pcall(function()
					Network.track(descendant)
				end)
				if not okTrack then
					Engine.consoleErrors += 1
				end
			end)
		end)
		if okConn and conn ~= nil then
			Engine.scanConns[#Engine.scanConns + 1] = conn
		end
	end
end

--- Call-site routing for locked clients: send through the recorded original when a
--- wrap exists, so traffic is never double-counted.
function Network.routedFire(instance: any, ...: any): boolean
	local packed = safeArgs(...)
	local stats = Engine.remoteByInstance[instance]
	local bucket = Engine.originals[instance]
	local startedClock = Clock.elapsed()
	local okCall, callErr = pcall(function(): any
		if bucket ~= nil and bucket.FireServer ~= nil then
			return (asAny(bucket.FireServer) :: any)(instance, table.unpack(packed, 1, packed.n))
		end
		return (instance :: any):FireServer(table.unpack(packed, 1, packed.n))
	end)
	local elapsed = Clock.elapsed() - startedClock
	local okTelemetry = pcall(function()
		if stats ~= nil then
			stats.fireCalls += 1
			noteActivity(stats)
			pushLatency(stats, elapsed)
			stats.bytesEstimated += Serialiser.estimateBytes(packed)
			if not okCall then
				stats.errors += 1
				stats.lastError = tostring(callErr)
			end
		end
		counter("fireCalls")
		local path = if stats ~= nil then stats.path else fullPath(instance)
		local detail = string.format("=> %s %s  dispatch=%s%s",
			Serialiser.signature(packed),
			describeArgs(packed),
			Util.millis(elapsed),
			if okCall then "" else ("  ERROR=" .. tostring(callErr))
		)
		emit(if okCall then "info" else "error", "net", "send.fire.routed", path, nil, detail)
	end)
	if not okTelemetry then
		Engine.consoleErrors += 1
	end
	return okCall
end

function Network.routedInvoke(instance: any, ...: any): (boolean, any)
	local packed = safeArgs(...)
	local stats = Engine.remoteByInstance[instance]
	local bucket = Engine.originals[instance]
	local startedClock = Clock.elapsed()
	local results = safeArgs(pcall(function(): any
		if bucket ~= nil and bucket.InvokeServer ~= nil then
			return (asAny(bucket.InvokeServer) :: any)(instance, table.unpack(packed, 1, packed.n))
		end
		return (instance :: any):InvokeServer(table.unpack(packed, 1, packed.n))
	end))
	local elapsed = Clock.elapsed() - startedClock
	local okCall = results[1] == true
	local okTelemetry = pcall(function()
		if stats ~= nil then
			stats.invokeCalls += 1
			noteActivity(stats)
			pushLatency(stats, elapsed)
			stats.bytesEstimated += Serialiser.estimateBytes(packed)
			if not okCall then
				stats.errors += 1
				stats.lastError = tostring(results[2])
			end
		end
		counter("invokeCalls")
		local path = if stats ~= nil then stats.path else fullPath(instance)
		local detail = string.format("=> %s %s  rtt=%s%s",
			Serialiser.signature(packed),
			describeArgs(packed),
			Util.millis(elapsed),
			if okCall then "" else ("  ERROR=" .. tostring(results[2]))
		)
		emit(if okCall then "info" else "error", "net", "invoke.routed", path, nil, detail)
	end)
	if not okTelemetry then
		Engine.consoleErrors += 1
	end
	return okCall, results[2]
end

