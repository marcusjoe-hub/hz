local AttributeSurveillance = {}

local PRIORITY: { [string]: boolean } = {}

local function rebuildPriorityIndex(): ()
	PRIORITY = {}
	for _, name in ipairs(Config.attributes.priorityKeys) do
		PRIORITY[string.lower(name)] = true
	end
end
rebuildPriorityIndex()

local function isPriorityKey(name: string): boolean
	return PRIORITY[string.lower(name)] == true
end

local function attributeHost(): any
	return playerRef()
end

local function readAttributeValue(host: any, name: string): any
	local ok, value = pcall(function(): any
		return (host :: any):GetAttribute(name)
	end)
	if ok then
		return value
	end
	return nil
end

local function ensureWatch(name: string): AttributeWatch
	local existing = Engine.attributes[name]
	if existing ~= nil then
		return existing
	end
	local host = attributeHost()
	local watch: AttributeWatch = {
		name = name,
		value = if host ~= nil then readAttributeValue(host, name) else nil,
		previousValue = nil,
		changes = 0,
		priority = isPriorityKey(name),
		firstSeenClock = Clock.elapsed(),
		lastChangeClock = Clock.elapsed(),
		lastChangeWall = Clock.wall(),
	}
	Engine.attributes[name] = watch
	return watch
end

local function connectAttribute(name: string): boolean
	if Engine.attributeConns[name] ~= nil then
		return true
	end
	local host = attributeHost()
	if host == nil then
		emit("warn", "attr", "watch.deferred", name, "LocalPlayer is not available yet")
		return false
	end
	local ok, conn = pcall(function(): any
		return (host :: any):GetAttributeChangedSignal(name):Connect(function()
			local okHandler, handlerErr = pcall(function()
				local watch = ensureWatch(name)
				local incoming = readAttributeValue(host, name)
				watch.previousValue = watch.value
				watch.value = incoming
				watch.changes += 1
				watch.lastChangeClock = Clock.elapsed()
				watch.lastChangeWall = Clock.wall()
				counter("attributeChanges")
				local detail = string.format("%s -> %s  (change #%d)",
					Serialiser.describe(watch.previousValue, 80),
					Serialiser.describe(incoming, 80),
					watch.changes
				)
				if watch.priority then
					emit("warn", "attr", "attribute.PRIORITY", name, nil, detail)
				else
					emit("info", "attr", "attribute.changed", name, nil, detail)
				end
			end)
			if not okHandler then
				Engine.consoleErrors += 1
				emit("error", "attr", "attribute.handler.error", name, tostring(handlerErr))
			end
		end)
	end)
	if ok and conn ~= nil then
		Engine.attributeConns[name] = conn
		return true
	end
	emit("warn", "attr", "watch.connect.failed", name, tostring(conn))
	return false
end

function AttributeSurveillance.watch(name: string): boolean
	if type(name) ~= "string" or name == "" then
		return false
	end
	ensureWatch(name)
	local connected = connectAttribute(name)
	if connected then
		emit("info", "attr", "watch.attached", name,
			if isPriorityKey(name) then "PRIORITY key" else "standard key")
	end
	return connected
end

function AttributeSurveillance.watchAll(): number
	local host = attributeHost()
	if host == nil then
		emit("warn", "attr", "watchAll.deferred", "", "LocalPlayer unavailable; will retry on poll")
		return 0
	end
	local ok, attributes = pcall(function(): any
		return (host :: any):GetAttributes()
	end)
	if not ok or type(attributes) ~= "table" then
		emit("warn", "attr", "watchAll.failed", "", tostring(attributes))
		return 0
	end
	local count = 0
	local names: { string } = {}
	for name in pairs(attributes :: { [string]: any }) do
		if type(name) == "string" then
			names[#names + 1] = name
		end
	end
	table.sort(names, function(a: string, b: string): boolean
		return a < b
	end)
	for _, name in ipairs(names) do
		if AttributeSurveillance.watch(name) then
			count += 1
		end
	end
	emit("info", "attr", "watchAll.complete", "", string.format("%d attribute(s) under surveillance", count))
	return count
end

function AttributeSurveillance.unwatch(name: string): boolean
	local conn = Engine.attributeConns[name]
	if conn == nil then
		return false
	end
	pcall(function()
		(conn :: any):Disconnect()
	end)
	Engine.attributeConns[name] = nil
	emit("info", "attr", "watch.detached", name, "listener disconnected")
	return true
end

--- Poll fallback. Covers attributes created after boot (which have no listener)
--- and players who arrive after the engine booted.
function AttributeSurveillance.poll(): number
	local host = attributeHost()
	if host == nil then
		return 0
	end
	local ok, attributes = pcall(function(): any
		return (host :: any):GetAttributes()
	end)
	if not ok or type(attributes) ~= "table" then
		return 0
	end
	local discovered = 0
	for name, value in pairs(attributes :: { [string]: any }) do
		if type(name) == "string" then
			local watch = Engine.attributes[name]
			if watch == nil then
				ensureWatch(name)
				if connectAttribute(name) then
					discovered += 1
					emit("info", "attr", "attribute.discovered", name,
						"new attribute observed after boot: " .. Serialiser.describe(value, 80))
				end
			elseif watch.value ~= value and Engine.attributeConns[name] == nil then
				watch.previousValue = watch.value
				watch.value = value
				watch.changes += 1
				watch.lastChangeClock = Clock.elapsed()
				watch.lastChangeWall = Clock.wall()
				counter("attributeChanges")
				emit("info", "attr", "attribute.polled", name, nil,
					string.format("%s -> %s (poll)",
						Serialiser.describe(watch.previousValue, 60),
						Serialiser.describe(value, 60)))
			end
		end
	end
	return discovered
end

function AttributeSurveillance.list(): { AttributeWatch }
	local out: { AttributeWatch } = {}
	for _, watch in pairs(Engine.attributes) do
		out[#out + 1] = {
			name = watch.name,
			value = watch.value,
			previousValue = watch.previousValue,
			changes = watch.changes,
			priority = watch.priority,
			firstSeenClock = watch.firstSeenClock,
			lastChangeClock = watch.lastChangeClock,
			lastChangeWall = watch.lastChangeWall,
		}
	end
	table.sort(out, function(a: AttributeWatch, b: AttributeWatch): boolean
		if a.priority ~= b.priority then
			return a.priority
		end
		return a.name < b.name
	end)
	return out
end

function AttributeSurveillance.get(name: string): any
	local watch = Engine.attributes[name]
	if watch ~= nil then
		return watch.value
	end
	local host = attributeHost()
	if host == nil then
		return nil
	end
	return readAttributeValue(host, name)
end

