--- Protective boot. Every failure mode here is contained: the module always
--- returns a usable API table, even when the environment refuses every hook.
local bootOk, bootErr = pcall(function()
	if not Config.autoBoot then
		return
	end
	Boot.start(nil)
end)

if not bootOk then
	Engine.consoleErrors += 1
	pcall(function()
		print("[DCORE] boot contained failure: " .. tostring(bootErr))
	end)
end

return API
