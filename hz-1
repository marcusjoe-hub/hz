function Network.listRemotes(): { RemoteStats }
	local out: { RemoteStats } = {}
	for _, stats in pairs(Engine.remotes) do
		out[#out + 1] = stats
	end
	table.sort(out, function(a: RemoteStats, b: RemoteStats): boolean
		return a.path < b.path
	end)
	return out
end

local API: DiagnosticAPI

local function verifyChain(): (boolean, string?)
	local previous = AuditRing.anchor(Engine.ring)
	local size = AuditRing.size(Engine.ring)
	for index = 1, size do
		local record = AuditRing.get(Engine.ring, index)
		if record == nil then
			return false, string.format("gap at retained index %d", index)
		end
		if record.prevHash ~= previous then
			return false, string.format("chain break at seq %d (prev mismatch)", record.seq)
		end
		local expected = Util.fnv1a(
			tostring(record.seq) .. "|" .. tostring(record.clock) .. "|" .. record.event .. "|" .. record.body,
			record.prevHash
		)
		if record.hash ~= expected then
			return false, string.format("hash mismatch at seq %d", record.seq)
		end
		previous = record.hash
	end
	return true, nil
end

local function toAuditRow(record: StoredRecord): AuditRow
	return {
		seq = record.seq,
		clock = record.clock,
		wall = record.wall,
		channel = record.channel,
		level = record.level,
		event = record.event,
		tag = record.tag,
		hash = record.hash,
		prevHash = record.prevHash,
		size = record.size,
		preview = Util.truncate(record.body, 240),
	}
end

local function aggregateLatency(): { [string]: number }
	local samples: { number } = {}
	for _, stats in pairs(Engine.remotes) do
		for _, value in ipairs(stats.latencySamples) do
			samples[#samples + 1] = value
		end
	end
	local worst = 0
	for _, value in ipairs(samples) do
		if value > worst then
			worst = value
		end
	end
	return {
		samples = #samples,
		p50 = Util.percentile(samples, 0.50),
		p95 = Util.percentile(samples, 0.95),
		p99 = Util.percentile(samples, 0.99),
		max = worst,
	}
end

API = {
	Boot = function(overrides: { [string]: any }?): boolean
		local ok, result = pcall(Boot.start, overrides)
		if not ok then
			Engine.consoleErrors += 1
			pcall(function()
				print("[DCORE] boot failure: " .. tostring(result))
			end)
			return false
		end
		return result == true
	end,

	Shutdown = function(): boolean
		local ok, result = pcall(Boot.stop)
		if not ok then
			Engine.consoleErrors += 1
			return false
		end
		return result == true
	end,

	IsRunning = function(): boolean
		return Engine.running
	end,

	Config = function(): EngineConfig
		return (Util.deepCopy(Config) :: any) :: EngineConfig
	end,

	Configure = function(overrides: { [string]: any }): boolean
		applyOverrides(overrides)
		emit("info", "sys", "config.updated", "", Serialiser.describe(overrides, 160))
		return true
	end,

	Scan = function(): number
		local ok, result = pcall(Network.scan)
		if not ok then
			emit("error", "net", "scan.error", "", tostring(result))
			return 0
		end
		return result
	end,

	TrackRemote = function(instance: InstanceRef): boolean
		local ok, result = pcall(Network.track, instance)
		if not ok then
			emit("error", "net", "track.error", "", tostring(result))
			return false
		end
		return result == true
	end,

	UntrackRemote = function(instance: InstanceRef): boolean
		local ok, result = pcall(Network.untrack, instance)
		if not ok then
			emit("error", "net", "untrack.error", "", tostring(result))
			return false
		end
		return result == true
	end,

	RoutedFire = function(instance: InstanceRef, ...: any): boolean
		local packed = safeArgs(...)
		local ok, result = pcall(Network.routedFire, instance, table.unpack(packed, 1, packed.n))
		if not ok then
			emit("error", "net", "routedFire.error", "", tostring(result))
			return false
		end
		return result == true
	end,

	RoutedInvoke = function(instance: InstanceRef, ...: any): (boolean, any)
		local packed = safeArgs(...)
		local ok, first, second = pcall(Network.routedInvoke, instance, table.unpack(packed, 1, packed.n))
		if not ok then
			emit("error", "net", "routedInvoke.error", "", tostring(first))
			return false, first
		end
		return first == true, second
	end,

	Remotes = function(): { RemoteStats }
		return Network.listRemotes()
	end,

	WatchAttribute = function(name: string): boolean
		local ok, result = pcall(AttributeSurveillance.watch, name)
		if not ok then
			emit("error", "attr", "watch.error", tostring(name), tostring(result))
			return false
		end
		return result == true
	end,

	UnwatchAttribute = function(name: string): boolean
		local ok, result = pcall(AttributeSurveillance.unwatch, name)
		if not ok then
			return false
		end
		return result == true
	end,

	WatchAllAttributes = function(): number
		local ok, result = pcall(AttributeSurveillance.watchAll)
		if not ok then
			emit("error", "attr", "watchAll.error", "", tostring(result))
			return 0
		end
		return result
	end,

	Attributes = function(): { AttributeWatch }
		local ok, result = pcall(AttributeSurveillance.list)
		if not ok then
			return {}
		end
		return result
	end,

	GetAttribute = function(name: string): any
		local ok, result = pcall(AttributeSurveillance.get, name)
		if not ok then
			return nil
		end
		return result
	end,

	Route = function(): RouteSnapshot
		local ok, result = pcall(SessionMonitor.readRoute)
		if not ok then
			return {
				placeId = nil, gameId = nil, jobId = nil, placeVersion = nil,
				isStudio = nil, serverTime = nil, distributedTime = nil,
				privateServerId = nil, loaded = nil,
				sessionClock = Clock.elapsed(), userId = nil,
			}
		end
		return result
	end,

	Teleports = function(): { TeleportRecord }
		local out: { TeleportRecord } = {}
		for index, record in ipairs(Engine.teleports) do
			out[index] = record
		end
		return out
	end,

	Sessions = function(): { SessionEvent }
		local out: { SessionEvent } = {}
		for index, event in ipairs(Engine.sessions) do
			out[index] = event
		end
		return out
	end,

	Audit = function(limit: number?): { AuditRow }
		local out: { AuditRow } = {}
		local size = AuditRing.size(Engine.ring)
		local first = if limit == nil then 1 else math.max(1, size - limit + 1)
		for index = first, size do
			local record = AuditRing.get(Engine.ring, index)
			if record ~= nil then
				out[#out + 1] = toAuditRow(record)
			end
		end
		return out
	end,

	Search = function(needle: string, limit: number?): { AuditRow }
		local out: { AuditRow } = {}
		local lowered = string.lower(needle)
		local size = AuditRing.size(Engine.ring)
		local cap = limit or math.huge
		for index = 1, size do
			local record = AuditRing.get(Engine.ring, index)
			if record ~= nil then
				local haystack = string.lower(record.channel .. "|" .. record.event .. "|" .. record.tag .. "|" .. record.body)
				if string.find(haystack, lowered, 1, true) ~= nil then
					out[#out + 1] = toAuditRow(record)
					if #out >= cap then
						break
					end
				end
			end
		end
		return out
	end,

	Verify = function(): (boolean, string?)
		local ok, first, second = pcall(verifyChain)
		if not ok then
			return false, tostring(first)
		end
		return first == true, second
	end,

	Metrics = function(): { [string]: any }
		local latency = aggregateLatency()
		local attributeCount = 0
		for _ in pairs(Engine.attributes) do
			attributeCount += 1
		end
		return {
			version = VERSION,
			session = Engine.session,
			running = Engine.running,
			uptime = Clock.elapsed() - Engine.startedClock,
			records = AuditRing.total(Engine.ring),
			buffered = AuditRing.size(Engine.ring),
			dropped = AuditRing.dropped(Engine.ring),
			errors = Engine.errors,
			consoleErrors = Engine.consoleErrors,
			remotes = #Network.listRemotes(),
			attributes = attributeCount,
			teleports = #Engine.teleports,
			latency = latency,
			counters = table.clone(Engine.metrics),
			integrity = (select(1, verifyChain())),
		}
	end,

	Report = function(): string
		local metrics = API.Metrics()
		local route = SessionMonitor.readRoute()
		local latency = metrics.latency :: { [string]: number }
		local lines: { string } = {
			string.rep("=", 78),
			string.format("DIAGNOSTICS CORE REPORT  v%s  session=%s", VERSION, Engine.session),
			string.rep("=", 78),
			string.format("  status          : %s   uptime %s",
				if Engine.running then "RUNNING" else "STOPPED",
				Util.millis(metrics.uptime :: number)),
			string.format("  route           : place=%s job=%s studio=%s",
				tostring(route.placeId), tostring(route.jobId), tostring(route.isStudio)),
			string.format("  records         : %s total, %d buffered, %d evicted",
				Util.commas(metrics.records :: number), metrics.buffered :: number, metrics.dropped :: number),
			string.format("  integrity       : %s", if metrics.integrity then "VERIFIED" else "BREAK DETECTED"),
			string.format("  errors          : %d engine, %d containment", metrics.errors :: number, metrics.consoleErrors :: number),
			string.rep("-", 78),
			string.format("  remotes tracked : %d", metrics.remotes :: number),
			string.format("  fire calls      : %s", Util.commas(Engine.metrics.fireCalls)),
			string.format("  invoke calls    : %s", Util.commas(Engine.metrics.invokeCalls)),
			string.format("  inbound events  : %s", Util.commas(Engine.metrics.inboundEvents)),
			string.format("  wraps applied   : %d (%d denied)", Engine.metrics.remoteWraps, Engine.metrics.remoteWrapDenials),
			string.format("  latency p50/p95 : %s / %s (%d samples)",
				Util.millis(latency.p50), Util.millis(latency.p95), latency.samples),
			string.rep("-", 78),
			string.format("  attributes      : %d tracked, %s changes",
				metrics.attributes :: number, Util.commas(Engine.metrics.attributeChanges)),
		}
		for _, watch in ipairs(AttributeSurveillance.list()) do
			lines[#lines + 1] = string.format("    %-24s = %-28s (changes=%d%s)",
				watch.name,
				Util.truncate(Serialiser.describe(watch.value, 40), 28),
				watch.changes,
				if watch.priority then ", PRIORITY" else "")
		end
		lines[#lines + 1] = string.rep("-", 78)
		lines[#lines + 1] = string.format("  teleports       : %d captured", metrics.teleports :: number)
		for _, record in ipairs(Engine.teleports) do
			lines[#lines + 1] = string.format("    [%s] %s place=%s result=%s %s",
				Util.millis(record.clock), record.kind,
				tostring(record.placeId), tostring(record.resultCode), tostring(record.message))
		end
		lines[#lines + 1] = string.rep("=", 78)
		return table.concat(lines, "\n")
	end,

	Dump = function(value: any): string
		local ok, text = pcall(function(): string
			return Serialiser.describe(value, 4096)
		end)
		if ok and type(text) == "string" then
			return text
		end
		return "<dump failed: " .. Serialiser.typeOf(value) .. ">"
	end,

	Banner = function(): string
		return Boot.banner()
	end,

	Clear = function(): boolean
		local ok = pcall(function()
			AuditRing.clear(Engine.ring)
			Engine.seq = 0
			emit("info", "sys", "buffer.cleared", "", "audit ring reset; chain restarted from anchor")
		end)
		return ok
	end,

	Console = {
