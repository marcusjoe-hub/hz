	"|                                                                              |",
	"|                 C  O  R  E   ::   client instrumentation                     |",
	"+------------------------------------------------------------------------------+",
}, "\n")

function Boot.banner(): string
	local route = SessionMonitor.readRoute()
	local lines: { string } = {
		BANNER_ART,
		"  DIAGNOSTICS CORE v" .. VERSION .. "  ::  " .. BUILD_TAG,
		"  classification: AUTHORIZED INTERNAL QA / NETWORK DIAGNOSTICS",
		string.rep("-", 78),
		string.format("  session      : %s", Engine.session),
		string.format("  place        : %s", tostring(route.placeId)),
		string.format("  job          : %s", tostring(route.jobId)),
		string.format("  studio       : %s", tostring(route.isStudio)),
		string.format("  console      : VERBOSE (rate limit %d/s, preview %d chars)",
			Config.console.rateLimitPerSecond, Config.console.payloadPreviewChars),
		string.format("  ansi colour  : %s", if Config.console.ansi then "ON (terminal capture)" else "OFF (Studio-safe channel colour)"),
		string.format("  redaction    : %s", if Config.redact.enabled then "ON" else "OFF"),
		string.format("  ring buffer  : %d records, hash-chained", Config.ringCapacity),
		string.rep("-", 78),
		"  LAYER A : network interceptor   ............ starting",
		"  LAYER B : attribute surveillance ........... starting",
		"  LAYER C : session & route telemetry ........ starting",
		"  LAYER D : self-contained execution ......... READY",
		string.rep("=", 78),
		"  ACTIVE CONSOLE LOGGING COMMENCED -- all telemetry is live.",
		string.rep("=", 78),
	}
	return table.concat(lines, "\n")
end

local function applyOverrides(overrides: { [string]: any }?): ()
	if overrides == nil then
		return
	end
	local ok, err = pcall(function()
		local function merge(target: any, source: any): ()
			for key, value in pairs(source) do
				if type(value) == "table" and type(target[key]) == "table" then
					merge(target[key], value)
				else
					target[key] = value
				end
			end
		end
		merge(Config :: any, overrides :: any)
		Config.ringCapacity = math.max(64, math.floor(tonumber(Config.ringCapacity) or 2048))
		Config.console.rateLimitPerSecond = math.max(1, math.floor(tonumber(Config.console.rateLimitPerSecond) or 120))
		Config.console.payloadPreviewChars = math.max(40, math.floor(tonumber(Config.console.payloadPreviewChars) or 220))
		Config.limits.maxDepth = math.max(1, math.floor(tonumber(Config.limits.maxDepth) or 6))
		Config.limits.maxKeys = math.max(1, math.floor(tonumber(Config.limits.maxKeys) or 32))
		rebuildPriorityIndex()
	end)
	if not ok then
		emit("warn", "sys", "config.rejected", "", tostring(err))
	end
end

function Boot.start(overrides: { [string]: any }?): boolean
	if Engine.running then
		return true
	end
	if Engine.booting then
		return false
	end
	Engine.booting = true

	applyOverrides(overrides)

	Engine.startedClock = Clock.elapsed()
	Engine.metrics.bootAt = Engine.startedClock
	Engine.ring = AuditRing.new(Config.ringCapacity)

	local entropy = string.format("%.6f|%d|%s", Engine.startedClock, Clock.wall(), BUILD_TAG)
	Engine.session = Util.hex32(Util.fnv1a(entropy))
		.. Util.hex32(Util.fnv1a(entropy .. "|" .. VERSION .. "|" .. tostring(#Engine.scanConns)))

	Engine.running = true

	local okBanner = pcall(function()
		print(Boot.banner())
	end)
	if not okBanner then
		Engine.consoleErrors += 1
	end

	local degraded: { string } = {}

	local function staged(name: string, fn: () -> ())
		local ok, err = pcall(fn)
		if not ok then
			degraded[#degraded + 1] = name
			emit("error", "sys", "stage.failed", name, tostring(err))
		end
	end

	staged("session", SessionMonitor.install)

	staged("scan", function()
		if not Config.scan.enabled then
			emit("info", "net", "scan.disabled", "", "network scan disabled by configuration")
			return
		end
		Network.scan()
		Network.watchRoots()
	end)

	staged("attributes", function()
		if not Config.attributes.enabled then
			emit("info", "attr", "surveillance.disabled", "", "attribute surveillance disabled by configuration")
			return
		end
		if Config.attributes.watchAll then
			AttributeSurveillance.watchAll()
		end
		if Config.attributes.pollInterval > 0 and taskLib ~= nil then
			Engine.attributePollThread = taskLib.spawn(function()
				while Engine.running do
					taskLib.wait(Config.attributes.pollInterval)
					pcall(AttributeSurveillance.poll)
				end
			end)
		end
	end)

	Engine.booting = false
	Engine.metrics.bootAt = Clock.elapsed()

	Console.rule(string.format("DIAGNOSTICS CORE v%s ONLINE  session=%s  degraded=%d", VERSION, Engine.session, #degraded))
	emit("info", "sys", "engine.online", "", string.format(
		"remotes=%d wraps=%d attributes=%d boot=%s",
		#Network.listRemotes(),
		Engine.metrics.remoteWraps,
		#AttributeSurveillance.list(),
		Util.millis(Clock.elapsed() - Engine.startedClock)
	))
	return true
end

function Boot.stop(): boolean
	if not Engine.running then
		return true
	end
	local ok = pcall(function()
		Engine.running = false

		if Engine.attributePollThread ~= nil and taskLib ~= nil then
			pcall(taskLib.cancel, Engine.attributePollThread)
			Engine.attributePollThread = nil
		end

		for _, conn in ipairs(Engine.connections) do
			pcall(function()
				(conn :: any):Disconnect()
			end)
		end
		Engine.connections = {}

		for _, conn in ipairs(Engine.scanConns) do
			pcall(function()
				(conn :: any):Disconnect()
			end)
		end
		Engine.scanConns = {}

		for name, conn in pairs(Engine.attributeConns) do
			pcall(function()
				(conn :: any):Disconnect()
			end)
			Engine.attributeConns[name] = nil
		end

		local tracked: { any } = {}
		for instance in pairs(Engine.remoteByInstance) do
			tracked[#tracked + 1] = instance
		end
		for _, instance in ipairs(tracked) do
			Network.untrack(instance)
		end

		emit("info", "sys", "engine.offline", "", string.format(
			"records=%d dropped=%d errors=%d uptime=%s",
			AuditRing.total(Engine.ring),
			AuditRing.dropped(Engine.ring),
			Engine.errors,
			Util.millis(Clock.elapsed() - Engine.startedClock)
		))
		Console.rule("DIAGNOSTICS CORE OFFLINE -- hooks restored, listeners disconnected")
	end)
	if not ok then
		Engine.consoleErrors += 1
		return false
	end
	return true
end

