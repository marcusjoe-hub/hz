			Console.SetANSI(enabled)
			emit("info", "sys", "console.ansi", "", if enabled then "ANSI palette enabled" else "ANSI palette disabled")
		end,
		SetRateLimit = function(perSecond: number): ()
			Console.SetRateLimit(perSecond)
			emit("info", "sys", "console.ratelimit", "", string.format("%d lines/second", Config.console.rateLimitPerSecond))
		end,
		Rule = function(title: string): ()
			Console.rule(title)
		end,
	},
}

