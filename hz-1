local SessionMonitor = {}

local function probeNumber(owner: any, property: string): number?
	if owner == nil then
		return nil
	end
	local ok, value = pcall(function(): any
		return (owner :: any)[property]
	end)
	if ok and type(value) == "number" then
		return value
	end
	return nil
end

local function probeString(owner: any, property: string): string?
	if owner == nil then
		return nil
	end
	local ok, value = pcall(function(): any
		return (owner :: any)[property]
	end)
	if ok and type(value) == "string" then
		return value
	end
	return nil
end

local function probeBoolean(owner: any, property: string): boolean?
	if owner == nil then
		return nil
	end
	local ok, value = pcall(function(): any
		return (owner :: any)[property]
	end)
	if ok and type(value) == "boolean" then
		return value
	end
	return nil
end

function SessionMonitor.readRoute(): RouteSnapshot
	local player = playerRef()
	local route: RouteSnapshot = {
		placeId = probeNumber(gameRef, "PlaceId"),
		gameId = probeNumber(gameRef, "GameId"),
		jobId = probeString(gameRef, "JobId"),
		placeVersion = probeNumber(gameRef, "PlaceVersion"),
		isStudio = nil,
		serverTime = nil,
		distributedTime = nil,
		privateServerId = probeString(gameRef, "PrivateServerId"),
		loaded = probeBoolean(gameRef, "Loaded"),
		sessionClock = Clock.elapsed(),
		userId = probeNumber(player, "UserId"),
	}

	if Services.RunService ~= nil then
		local okStudio, isStudio = pcall(function(): any
			return (Services.RunService :: any):IsStudio()
		end)
		if okStudio and type(isStudio) == "boolean" then
			route.isStudio = isStudio
		end
	end

	if workspaceRef ~= nil then
		local okTime, serverTime = pcall(function(): any
			return (workspaceRef :: any):GetServerTimeNow()
		end)
		if okTime and type(serverTime) == "number" then
			route.serverTime = serverTime
		end
		local okDist, distributed = pcall(function(): any
			return (workspaceRef :: any):DistributedGameTime()
		end)
		if okDist and type(distributed) == "number" then
			route.distributedTime = distributed
		end
	end

	return route
end

local function formatRoute(route: RouteSnapshot): string
	return string.format(
		"place=%s game=%s version=%s job=%s studio=%s privateServer=%s serverTime=%s",
		tostring(route.placeId),
		tostring(route.gameId),
		tostring(route.placeVersion),
		tostring(route.jobId),
		tostring(route.isStudio),
		tostring(route.privateServerId),
		tostring(route.serverTime)
	)
end

function SessionMonitor.recordSession(kind: string, detail: string): ()
	Engine.sessions[#Engine.sessions + 1] = {
		clock = Clock.elapsed(),
		kind = kind,
		detail = detail,
	}
	if #Engine.sessions > 128 then
		table.remove(Engine.sessions, 1)
	end
end

function SessionMonitor.recordTeleport(kind: string, info: any): ()
	local record: TeleportRecord = {
		clock = Clock.elapsed(),
		wall = Clock.wall(),
		kind = kind,
		placeId = nil,
		resultCode = nil,
		message = nil,
		ok = true,
	}
	if type(info) == "table" then
		if type(info.placeId) == "number" then
			record.placeId = info.placeId
		end
		if type(info.resultCode) == "number" then
			record.resultCode = info.resultCode
		end
		if type(info.message) == "string" then
			record.message = Util.stripControl(info.message)
		end
		if type(info.ok) == "boolean" then
			record.ok = info.ok
		end
	end
	Engine.teleports[#Engine.teleports + 1] = record
	if #Engine.teleports > 64 then
		table.remove(Engine.teleports, 1)
	end
	counter("routeEvents")
	emit(if record.ok then "info" else "warn", "route", "teleport." .. kind, tostring(record.placeId),
		string.format("placeId=%s result=%s message=%s",
			tostring(record.placeId),
			tostring(record.resultCode),
			tostring(record.message)))
end

local function attachConnection(okFlag: boolean, conn: any, label: string, container: { any }): ()
	if okFlag and conn ~= nil then
		container[#container + 1] = conn
	else
		emit("debug", "sys", "hook.unavailable", label, "signal not connectable on this client")
	end
end

function SessionMonitor.install(): ()
	Engine.route = SessionMonitor.readRoute()
	emit("info", "route", "route.snapshot", "", formatRoute(Engine.route))
	SessionMonitor.recordSession("boot", formatRoute(Engine.route))

	-- game.Loaded : fires when the DataModel finishes loading on the client
	if gameRef ~= nil then
		local okConn, conn = pcall(function(): any
			return (gameRef :: any).Loaded:Connect(function()
				Engine.route = SessionMonitor.readRoute()
				emit("info", "route", "game.loaded", "", formatRoute(Engine.route))
				SessionMonitor.recordSession("loaded", formatRoute(Engine.route))
			end)
		end)
		attachConnection(okConn, conn, "game.Loaded", Engine.connections)
	end

	-- LocalPlayer availability (the client may boot before the player exists)
	if Services.Players ~= nil then
		local okConn, conn = pcall(function(): any
			return (Services.Players :: any).PlayerAdded:Connect(function(player: any)
				local okCompare, isLocal = pcall(function(): boolean
					return player == (Services.Players :: any).LocalPlayer
				end)
				if okCompare and isLocal then
					emit("info", "sys", "player.arrived", fullPath(player), "LocalPlayer is now available")
					SessionMonitor.recordSession("player", fullPath(player))
					if Config.attributes.enabled and Config.attributes.watchAll then
						pcall(AttributeSurveillance.watchAll)
					end
				end
			end)
		end)
		attachConnection(okConn, conn, "Players.PlayerAdded", Engine.connections)
	end

	-- Character lifecycle
	if Config.session.watchCharacter then
		local player = playerRef()
		if player ~= nil then
			local okConn, conn = pcall(function(): any
				return (player :: any).CharacterAdded:Connect(function(character: any)
					emit("info", "sys", "character.added", fullPath(character), "local character spawned")
					SessionMonitor.recordSession("character.added", fullPath(character))
				end)
			end)
			attachConnection(okConn, conn, "Player.CharacterAdded", Engine.connections)
			local okConn2, conn2 = pcall(function(): any
				return (player :: any).CharacterRemoving:Connect(function(character: any)
					emit("info", "sys", "character.removing", fullPath(character), "local character despawned")
					SessionMonitor.recordSession("character.removing", fullPath(character))
				end)
			end)
			attachConnection(okConn2, conn2, "Player.CharacterRemoving", Engine.connections)
		else
			emit("debug", "sys", "character.watch.deferred", "", "LocalPlayer absent at boot")
		end
	end

	-- TeleportService routing
	if Config.session.watchTeleports and Services.TeleportService ~= nil then
		local service = Services.TeleportService
		local okFail, failConn = pcall(function(): any
			return (service :: any).TeleportInitFailed:Connect(function(_player: any, result: any, message: any, placeId: any)
				local code: number? = nil
				local okCode, value = pcall(function(): any
					return (result :: any).Value
				end)
				if okCode and type(value) == "number" then
					code = value
				end
				SessionMonitor.recordTeleport("failed", {
					ok = false,
					placeId = if type(placeId) == "number" then placeId else nil,
					resultCode = code,
					message = if type(message) == "string" then message else nil,
				})
			end)
		end)
		attachConnection(okFail, failConn, "TeleportInitFailed", Engine.connections)

		local okArrive, arriveConn = pcall(function(): any
			return (service :: any).LocalPlayerArrivedFromTeleport:Connect(function()
				Engine.route = SessionMonitor.readRoute()
				emit("info", "route", "teleport.arrived", "", formatRoute(Engine.route))
				SessionMonitor.recordSession("teleport.arrived", formatRoute(Engine.route))
			end)
		end)
		attachConnection(okArrive, arriveConn, "LocalPlayerArrivedFromTeleport", Engine.connections)
	end
end

