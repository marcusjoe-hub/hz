local Boot = {}

local BANNER_ART: string = table.concat({
	"+------------------------------------------------------------------------------+",
	"|                                                                              |",
	"|    ####   ####      ###     ####   ###    ###   ####   #####  ###   #####    |",
	"|    #   #  #         #   #   #      #   #  #   # #         #   #      #       |",
	"|    #   #  ###       #####   #  ##  #   #  #   #  ###      #   #      ###     |",
	"|    #   #  #         #   #   #   #  #   #  #   #     #     #   #      #       |",
