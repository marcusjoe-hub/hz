local function safeArgs(...: any): PackedArgs
	return (table.pack(...) :: any) :: PackedArgs
end

--- Launders a value through a real function boundary so the type checker treats
--- dynamically-resolved members as `any` instead of inferring a narrow type.
local function asAny(value: any): any
	return value
end

--- Guarded engine `typeof`. Passing the resolved function as a DIRECT pcall
--- argument keeps the strict analyser from binding it to an error type; calling a
--- captured `any` global through an inline closure does not.
local function engineTypeof(value: any): string?
	if typeofGlobal == nil then
		return nil
	end
	local fn = typeofGlobal
	if type(fn) ~= "function" then
		return nil
	end
	local ok, label = pcall(fn, value)
	if ok and type(label) == "string" then
		return label
	end
	return nil
end

--================================================================================
-- SECTION 4 :: CLOCK
--================================================================================

local Clock = {}

local BOOT_RAW: number = 0
do
	local ok, value = pcall(function(): number
		return os.clock()
	end)
	if ok and type(value) == "number" then
		BOOT_RAW = value
	end
end

function Clock.monotonic(): number
	local ok, value = pcall(function(): number
		return os.clock()
	end)
	if ok and type(value) == "number" and value == value then
		return value - BOOT_RAW
	end
	-- Widening tolerance rather than injecting a hostile wall-clock offset into a
	-- hash chain: a fallback that returns monotonic zero keeps ordering stable.
	return 0
end

function Clock.wall(): number
	local ok, value = pcall(function(): number
		return os.time()
	end)
	if ok and type(value) == "number" then
		return value
	end
	return 0
end

function Clock.elapsed(): number
	return Clock.monotonic() - CLOCK_ORIGIN
end

function Clock.stamp(): string
	return string.format("%.3f", Clock.elapsed())
end

--================================================================================
-- SECTION 5 :: NUMERIC + HASH + ENCODING UTILITIES
--================================================================================

local FNV_OFFSET: number = 2166136261
local FNV_PRIME: number = 16777619

local Util = {}

--- 32-bit multiply composed from 16-bit steps (bit32 exposes no full-width mul).
function Util.mul32(a: number, b: number): number
	local aLow = bit32.band(a, 0xFFFF)
	local aHigh = bit32.rshift(a, 16)
	local bLow = bit32.band(b, 0xFFFF)
	local bHigh = bit32.rshift(b, 16)
	local low = aLow * bLow
	local mid = aHigh * bLow + aLow * bHigh
	return bit32.band(low + bit32.lshift(bit32.band(mid, 0xFFFF), 16), 0xFFFFFFFF)
end

function Util.fnv1a(text: string, seed: number?): number
	local hash = seed or FNV_OFFSET
	for index = 1, #text do
		hash = Util.mul32(bit32.bxor(hash, string.byte(text, index)), FNV_PRIME)
	end
	return hash
end

function Util.hex32(value: number): string
	return string.format("%08x", value)
end

function Util.clamp(value: number, minimum: number, maximum: number): number
	if value < minimum then
		return minimum
	elseif value > maximum then
		return maximum
	end
	return value
end

function Util.round(value: number, places: number?): number
	local factor = 10 ^ (places or 2)
	return math.floor(value * factor + 0.5) / factor
end

function Util.commas(value: number): string
	local text = tostring(math.floor(value))
	local sign = ""
	if string.sub(text, 1, 1) == "-" then
		sign = "-"
		text = string.sub(text, 2)
	end
	local out = ""
	local count = 0
	for index = #text, 1, -1 do
		out = string.sub(text, index, index) .. out
		count += 1
		if count % 3 == 0 and index > 1 then
			out = "," .. out
		end
	end
	return sign .. out
end

function Util.bytes(value: number): string
	if value < 1024 then
		return string.format("%d B", math.floor(value))
	elseif value < 1048576 then
		return string.format("%.1f KB", value / 1024)
	end
	return string.format("%.2f MB", value / 1048576)
end

function Util.millis(seconds: number): string
	local ms = seconds * 1000
	if ms < 1 then
		return string.format("%.0f us", ms * 1000)
	elseif ms < 1000 then
		return string.format("%.2f ms", ms)
	end
	return string.format("%.2f s", seconds)
end

function Util.padEnd(text: string, width: number): string
	if #text >= width then
		return text
	end
	return text .. string.rep(" ", width - #text)
end

function Util.padStart(text: string, width: number): string
	if #text >= width then
		return text
	end
	return string.rep(" ", width - #text) .. text
end

function Util.truncate(text: string, width: number): string
	if width <= 0 then
		return ""
	end
	if #text <= width then
		return text
	end
	if width <= 3 then
		return string.sub(text, 1, width)
	end
	return string.sub(text, 1, width - 3) .. "..."
end

function Util.stripControl(text: string): string
	return (string.gsub(text, "[%z\1-\31\127]", "?"))
end

local B64_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

local function b64Char(value: number): string
	return string.sub(B64_ALPHABET, value + 1, value + 1)
end

function Util.b64encode(binary: string): string
	local length = #binary
	local out: { string } = {}
	local index = 1
	while index + 2 <= length do
		local a, b, c = string.byte(binary, index, index + 2)
		local block = a * 65536 + b * 256 + c
		out[#out + 1] = b64Char(math.floor(block / 262144) % 64)
		out[#out + 1] = b64Char(math.floor(block / 4096) % 64)
		out[#out + 1] = b64Char(math.floor(block / 64) % 64)
		out[#out + 1] = b64Char(block % 64)
		index += 3
	end
	local rem = length - index + 1
	if rem == 1 then
		local a = string.byte(binary, index)
		local block = a * 65536
		out[#out + 1] = b64Char(math.floor(block / 262144) % 64)
		out[#out + 1] = b64Char(math.floor(block / 4096) % 64)
		out[#out + 1] = "=="
	elseif rem == 2 then
		local a, b = string.byte(binary, index, index + 1)
		local block = a * 65536 + b * 256
		out[#out + 1] = b64Char(math.floor(block / 262144) % 64)
		out[#out + 1] = b64Char(math.floor(block / 4096) % 64)
		out[#out + 1] = b64Char(math.floor(block / 64) % 64)
		out[#out + 1] = "="
	end
	return table.concat(out)
end

function Util.percentile(samples: { number }, fraction: number): number
	local length = #samples
	if length == 0 then
		return 0
	end
	local copy = table.clone(samples)
	table.sort(copy)
	local index = math.floor(fraction * (length - 1) + 0.5) + 1
	index = Util.clamp(index, 1, length)
	return copy[index]
end

function Util.deepCopy(source: any): any
	if type(source) ~= "table" then
		return source
	end
	local copy = {}
	for key, value in pairs(source) do
		if type(value) == "table" then
			copy[key] = Util.deepCopy(value)
		else
			copy[key] = value
		end
	end
	return copy
end

